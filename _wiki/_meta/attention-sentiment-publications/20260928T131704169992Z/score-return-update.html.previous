radius:12px;overflow:hidden;min-width:0}.sr-card-head{padding:18px 22px 13px}.sr-card h2{font-size:17px;margin:0;color:var(--sr-text)}.sr-card h2 span{font-size:12px;font-weight:400;color:var(--sr-muted);margin-left:10px}.sr-card-head p{font-size:12px;margin:6px 0 0;color:var(--sr-muted)}.sr-card svg{display:block;width:100%;height:auto}.sr-chart-foot{font-size:12px;padding:0 22px 18px;color:#e2b978}.sr-chart-foot>span:last-child{color:var(--sr-muted)}.sr-dash{display:inline-block;width:18px;border-top:2px dashed #e2b978;vertical-align:middle;margin-right:6px}.sr-scroll{overflow:auto}.sr-table{border-collapse:collapse;width:100%;font-size:12px;font-variant-numeric:tabular-nums}.sr-table th,.sr-table td{padding:11px 13px;border-bottom:1px solid var(--sr-line);text-align:right;white-space:nowrap}.sr-table th:first-child{text-align:left}.sr-table thead{background:#192a40;color:var(--sr-muted)}.sr-table thead tr:first-child th[colspan]{text-align:center}.sr-table tbody th{font-weight:600}.sr-table tbody tr:hover{background:#1b2c44}.sr-current{background:#1a3350!important}.sr-current th span{font-size:10px;color:var(--sr-blue);display:block}.sr-baseline{color:var(--sr-muted);background:#15273d}.sr-range{font-size:11px;color:var(--sr-muted)}.sr-positive{color:var(--sr-green)!important}.sr-negative{color:var(--sr-red)!important}.sr-foot{font-size:12px;color:var(--sr-muted);padding:13px 22px;margin:0}.sr-method{padding:22px;color:var(--sr-muted);font-size:13px}.sr-method ol{padding-left:19px;margin:16px 0}.sr-method li{margin:10px 0}.sr-method b{color:var(--sr-text)}.sr-method details{border-top:1px solid var(--sr-line);padding-top:13px}.sr-method summary{cursor:pointer;color:var(--sr-blue)}.sr-note{padding:14px 20px;background:#352e25;color:#e8c28a;border-radius:9px;font-size:13px}.sr-kpis{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:18px 0}.sr-kpis>div{padding:17px 20px;background:#17283f;border:1px solid #30455f;border-radius:9px}.sr-kpis span,.sr-kpis small{color:#a5b5cb;font-size:12px}.sr-kpis strong{display:block;font-size:28px;margin:4px 0}.sr-kpis p{color:#a5b5cb;font-size:13px;margin:4px 0}.sr-inline .inline-note a{color:#90b4ff}
