t-size:21px}.rd-app .sr-header{flex-wrap:wrap}.rd-app .sr-context{grid-template-columns:1fr}.rd-app .sr-toolbar{padding:15px}.rd-app .sr-toolbar label{max-width:100%}.rd-app .sr-toolbar select{min-width:0;max-width:100%}}
@media(prefers-reduced-motion:reduce){.rd-app *{scroll-behavior:auto!important;transition:none!important}}
@media(max-width:600px){.rd-app .wl .wl-title{font-size:23px;letter-spacing:-.6px}}
@media print{.rd-sidebar,.rd-actions,.rd-skip{display:none}.rd-workspace{margin:0}.rd-topbar{position:static;padding:0 0 20px}.rd-app main{padding:20px 0;max-width:none}.rd-app .card,.rd-app .wl-card,.rd-app .rd-context{break-inside:avoid;box-shadow:none}.rd-app .wl-chart>svg{min-width:0}}
</style></head><body><div class="rd-app rd-radar"><a class="rd-skip" href="#research-main">Skip to content</a><aside class="rd-sidebar"><a class="rd-brand" href="../index.html" aria-label="Capstone research dashboards"><span class="rd-brand-mark" aria-hidden="true">C</span><span>CAPSTONE<small>RESEARCH INTELLIGENCE</small></span></a><nav class="rd-navigation" aria-label="Research dashboards"><div class="rd-nav-group"><p>Sentiment monitor</p><a href="index.html"><span aria-hidden="true">01</span>Research overview</a><a href="crowding-tracker.html" aria-current="page"><span aria-hidden="true">02</span>Market radar</a><a href="cnn-next-week.html"><span aria-hidden="true">03</span>Fear &amp; Greed</a><a href="daily-brief.html"><span aria-hidden="true">04</span>Daily briefing</a></div><div class="rd-nav-group"><p>Stocks &amp; evidence</p><a href="score-returns.html"><span aria-hidden="true">05</span>Score &amp; returns</a><a href="specialist-sales.html"><span aria-hidden="true">06</span>Specialist sales</a><a href="narrative-diffusion.html"><span aria-hidden="true">07</span>Narrative research</a></div><div class="rd-nav-group"><p>Methodology</p><a href="cnn-spy-qqq-study.html"><span aria-hidden="true">08</span>CNN · full study</a></div></nav><div class="rd-local-label">RADAR VIEWS</div><nav class="nav" role="tablist" aria-label="Research views"><button role="tab" id="tab-radar" aria-controls="view-radar" aria-selected="true" data-view="radar"><span class="nav-number">01</span>Market radar</button><button role="tab" id="tab-stock" aria-controls="view-stock" aria-selected="false" data-view="stock"><span class="nav-number">02</span>Stock deep dive</button><button role="tab" id="tab-narrative" aria-controls="view-narrative" aria-selected="false" data-view="narrative"><span class="nav-number">03</span>Narratives & desks</button><button role="tab" id="tab-market" aria-controls="view-market" aria-selected="false" data-view="market"><span class="nav-number">04</span>CNN × SPY / QQQ</button><button role="tab" id="tab-method" aria-controls="view-method" aria-selected="false" data-view="method"><span class="nav-number">05</span>Research & next steps</button></nav><div class="rd-sidebar-footer">MARKET RESEARCH<small>CNN · Bloomberg · X · specialist sales</small><a href="../openrouter.html#token-growth">AI demand monitor <span aria-hidden="true">↗</span></a><a href="../index.html">All research dashboards <span aria-hidden="true">↗</span></a></div></aside><div class="rd-workspace"><header class="rd-topbar"><div><p>RESEARCH / MARKET SENTIMENT</p><h1>Attention &amp; sentiment</h1></div><div class="rd-actions"><span class="rd-asof">Price snapshot<b>2026-09-25</b></span><button type="button" class="rd-theme" aria-label="Switch to dark theme" aria-pressed="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20.5 13A8.5 8.5 0 0 1 11 3.5 8.5 8.5 0 1 0 20.5 13Z"/></svg></button></div></header>


<main id="research-main" tabindex="-1"><div id="loading" class="loading" role="status"><div class="spinner"></div><strong>Opening the research snapshot</strong>Prices, mentions and source evidence are included in this file.</div>
<section class="view" id="view-radar" role="tabpanel" aria-labelledby="tab-radar" hidden></section><section class="view" id="view-stock" role="tabpanel" aria-labelledby="tab-stock" hidden></section><section class="view" id="view-narrative" role="tabpanel" aria-labelledby="tab-narrative" hidden></section><section class="view" id="view-market" role="tabpanel" aria-labelledby="tab-market" hidden></section><section class="view" id="view-method" role="tabpanel" aria-labelledby="tab-method" hidden></section>
<footer class="footer"><span>Bloomberg · collected X posts · specialist sales · CNN</span><span>Experimental indicators. Attention is observable; crowded holdings are not established.</span></footer></main><div id="tooltip" class="tooltip" hidden></div><noscript><p class="loading">Enable JavaScript in a modern browser to explore this self-contained dashboard.</p></noscript>
<script id="snapshot" type="application/octet-stream"></script><script>/* Shared, offline conditional-return explorer: dashboard and standalone study. */
(function(global){
'use strict';
const colors={SPY:'var(--rd-blue)',QQQ:'var(--rd-teal)'},valid=x=>typeof x==='number'&&Number.isFinite(x);
const f=(x,n=2,sign=false)=>valid(x)?(sign&&x>0?'+':'')+x.toLocaleString('en-US',{minimumFractionDigits:n,maximumFractionDigits:n}):'—';
const pct=x=>valid(x)?f(x,2,true)+'%':'—',esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const scale=(a,b,c,d)=>v=>c+(v-a)/(b-a||1)*(d-c);
const interval=(r,key='mean_ci95',unit='%')=>r[key]?f(r[key][0],2,true)+unit+' to '+f(r[key][1],2,true)+unit:'Insufficient sample';
const label=c=>c===0?'0–<5':c===100?'95–100':`${c-5}–<${c+5}`;
const css=`.wl{font:16px/1.5 'Segoe UI',Arial,sans-serif;color:var(--rd-ink)}.wl *{box-sizing:border-box}.wl h1,.wl h2,.wl h3,.wl p{margin:0}.wl h1{font-size:28px;letter-spacing:-.7px;line-height:1.25}.wl h2{font-size:20px;letter-spacing:-.3px}.wl h3{font-size:17px}.wl p{font-size:14px;color:var(--rd-muted)}.wl-head{display:flex;justify-content:space-between;gap:18px;align-items:end;margin:0 0 18px}.wl-head p{margin-top:6px}.wl-controls{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:20px}.wl label{font-size:14px;color:var(--rd-muted)}.wl select,.wl button.wl-btn{font:14px 'Segoe UI',sans-serif;color:var(--rd-ink);background:var(--rd-surface);border:1px solid var(--rd-border);border-radius:7px;padding:9px 11px;max-width:100%}.wl button,.wl select{cursor:pointer}.wl button:focus-visible,.wl select:focus-visible,.wl [tabindex]:focus-visible{outline:3px solid #5796ff;outline-offset:3px}.wl-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:15px;margin:0 0 20px}.wl-tile{border:1px solid var(--rd-border);border-radius:12px;background:var(--rd-surface);padding:16px 18px;text-align:left;color:var(--rd-ink)}.wl-tile[aria-pressed=true]{border-color:var(--rd-blue);box-shadow:inset 0 0 0 1px var(--rd-blue)}.wl-tile strong{font-size:29px;font-weight:600;letter-spacing:-.8px}.wl-tile small{display:block;color:var(--rd-muted);font-size:12px}.wl-tile p{margin-top:8px;font-size:14px}.wl-tile b{font-variant-numeric:tabular-nums}.wl-card{background:var(--rd-surface);border:1px solid var(--rd-border);border-radius:14px;overflow:hidden;margin-bottom:20px}.wl-card-head{padding:19px 22px 12px;display:flex;gap:14px;flex-wrap:wrap;justify-content:space-between;align-items:start}.wl-card-head p{margin-top:4px}.wl-card-body{padding:0 22px 20px}.wl-chart{overflow:auto}.wl svg{display:block;width:100%;height:auto}.wl svg text{font:14px 'Segoe UI',Arial,sans-serif;fill:var(--rd-muted)}.wl-legend{display:flex;gap:18px;align-items:center;flex-wrap:wrap;font-size:13px;color:var(--rd-muted)}.wl-legend i{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:5px}.wl-note{font-size:12px;color:var(--rd-muted);padding:12px 22px;border-top:1px solid var(--rd-grid)}.wl-baseline{background:var(--rd-soft);color:var(--rd-ink);border-radius:10px;padding:15px 20px;display:flex;gap:26px;align-items:center;flex-wrap:wrap;margin-bottom:20px;font-size:14px}.wl-baseline b{font-size:18px}.wl-split{display:grid;grid-template-columns:1fr 1fr;gap:20px}.wl-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;padding-top:10px}.wl-stats strong{display:block;font-size:23px;letter-spacing:-.6px;font-variant-numeric:tabular-nums}.wl-stats span{display:block;font-size:12px;color:var(--rd-muted)}.wl-up{color:var(--rd-teal)}.wl-down{color:var(--rd-red)}.wl-callout{background:var(--rd-blue-wash);padding:14px 17px;border-radius:8px;margin-top:15px;font-size:14px;line-height:1.6}.wl-callout.warn{background:var(--rd-amber-wash);color:var(--rd-amber)}.wl-scroll{overflow:auto}.wl table{width:100%;border-collapse:collapse;font-size:14px}.wl th,.wl td{padding:11px 16px;border-bottom:1px solid var(--rd-grid);text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums}.wl th{font-size:12px;background:var(--rd-soft);color:var(--rd-muted)}.wl th:first-child,.wl td:first-child{text-align:left}.wl .wl-empty{padding:28px 0;color:var(--rd-muted);font-size:15px}.wl details{margin-top:15px}.wl summary{cursor:pointer;font-size:14px;font-weight:600}.wl details p{margin-top:10px;line-height:1.7}.wl-link{color:var(--rd-blue);text-decoration:none}.wl-small{font-size:12px;color:var(--rd-muted)}.wl-gap{margin-bottom:20px}.wl-group:hover .wl-hover,.wl-group:focus .wl-hover{fill:var(--rd-blue-wash);fill-opacity:.55}.wl-group{cursor:pointer}@media(max-width:850px){.wl-summary{grid-template-columns:1fr 1fr}.wl-split{grid-template-columns:1fr}.wl-head{align-items:start;flex-direction:column}}@media(max-width:560px){.wl-summary{gap:10px}.wl-tile{padding:12px}.wl-tile strong{font-size:24px}.wl-card-head,.wl-card-body{padding-left:15px;padding-right:15px}.wl-chart>svg{min-width:650px}.wl-stats{gap:8px}.wl-stats strong{font-size:20px}}`;

function stats(data,state,t,c=state.level){return data.results[t][state.timing].groups[state.sample+'_'+c];}
function barChart(data,state){const centers=state.sample==='cross'?data.meta.thresholds:data.meta.centers;const w=1080,h=370,l=66,r=24,t=26,b=75,all=centers.flatMap(c=>['SPY','QQQ'].map(t=>stats(data,state,t,c))),vals=all.flatMap(r=>[r.mean_pct,...(r.mean_ci95||[])]).filter(valid);let lo=Math.min(0,...vals),hi=Math.max(0,...vals);const pad=(hi-lo||1)*.13;lo-=pad;hi+=pad;const y=scale(lo,hi,h-b,t),step=(w-l-r)/centers.length;let body='';for(let k=0;k<5;k++){const v=lo+(hi-lo)*k/4;body+=`<line x1="${l}" x2="${w-r}" y1="${y(v)}" y2="${y(v)}" stroke="var(--rd-grid)"/><text x="${l-10}" y="${y(v)+5}" text-anchor="end">${f(v,1)}%</text>`;}body+=`<line x1="${l}" x2="${w-r}" y1="${y(0)}" y2="${y(0)}" stroke="#9cafc4"/>`;
 centers.forEach((c,i)=>{const xx=l+step*(i+.5),sr=stats(data,state,'SPY',c),selected=c===state.level;body+=`<g class="wl-group" role="button" tabindex="0" data-wl-level="${c}" aria-label="Explore CNN ${c}; ${sr.n} observations"><rect class="wl-hover" x="${xx-step*.48}" y="${t}" width="${step*.96}" height="${h-b-t}" rx="5" fill="${selected?'var(--rd-blue-wash)':'var(--rd-surface)'}" fill-opacity="${selected?1:0}"/>`;
 for(const [ticker,offset] of [['SPY',-12],['QQQ',12]]){const s=stats(data,state,ticker,c),col=colors[ticker],cx=xx+offset;if(!s.n)continue;const mean=s.mean_pct;body+=`<rect x="${cx-8}" y="${y(Math.max(0,mean))}" width="16" height="${Math.max(1,Math.abs(y(mean)-y(0)))}" rx="2" fill="${col}" opacity="${s.n<20?.45:.9}"/>`;if(s.mean_ci95){const [a,b]=s.mean_ci95;body+=`<line x1="${cx}" x2="${cx}" y1="${y(a)}" y2="${y(b)}" stroke="${col}" stroke-width="1.5"/><line x1="${cx-4}" x2="${cx+4}" y1="${y(a)}" y2="${y(a)}" stroke="${col}"/><line x1="${cx-4}" x2="${cx+4}" y1="${y(b)}" y2="${y(b)}" stroke="${col}"/>`;}body+=`<title>${ticker}, CNN ${c}: mean ${pct(mean)}, median ${pct(s.median_pct)}, up ${f(s.positive_pct,1)}%, n=${s.n}</title>`;}
 body+=`<text x="${xx}" y="${h-b+24}" text-anchor="middle" style="fill:${selected?'var(--rd-blue)':'var(--rd-ink)'};font-weight:600">${state.sample==='cross'?(c<=30?'≤':'≥'):''}${c}</text><text x="${xx}" y="${h-b+44}" text-anchor="middle" style="font-size:12px">${sr.n?'n='+sr.n:'No data'}</text></g>`;});body+=`<text x="${w/2}" y="${h-7}" text-anchor="middle">${state.sample==='cross'?'CNN threshold crossed · selected windows do not overlap':'CNN level · fixed ±5-point bands'}</text>`;return `<svg viewBox="0 0 ${w} ${h}" role="img" aria-label="Mean next-week returns after CNN levels, with uncertainty">${body}</svg>`;}
function distribution(data,state){const a=stats(data,state,'SPY'),b=stats(data,state,'QQQ'),rr=[a,b];if(!a.n)return '<div class="wl-empty">No observations in this sample. The maximum CNN reading was '+f(data.meta.observed_max,2)+'.</div>';const vals=rr.flatMap(r=>[r.p10_pct,r.p90_pct,0]).filter(valid),lo=Math.min(...vals)-.3,hi=Math.max(...vals)+.3,w=760,h=205,l=65,r=24,x=scale(lo,hi,l,w-r);let body='';for(let k=0;k<5;k++){const v=lo+(hi-lo)*k/4;body+=`<line x1="${x(v)}" x2="${x(v)}" y1="20" y2="155" stroke="var(--rd-grid)"/><text x="${x(v)}" y="185" text-anchor="middle">${f(v,1)}%</text>`;}body+=`<line x1="${x(0)}" x2="${x(0)}" y1="20" y2="155" stroke="#9eb2cf" stroke-dasharray="4 3"/>`;['SPY','QQQ'].forEach((t,i)=>{const s=rr[i],yy=58+i*65;body+=`<text x="10" y="${yy+5}" style="fill:${colors[t]};font-weight:700">${t}</text><line x1="${x(s.p10_pct)}" x2="${x(s.p90_pct)}" y1="${yy}" y2="${yy}" stroke="${colors[t]}" stroke-width="12" stroke-opacity=".2" stroke-linecap="round"/><circle cx="${x(s.median_pct)}" cy="${yy}" r="6" fill="${colors[t]}"/><path d="M${x(s.mean_pct)},${yy-8} l6,8 l-6,8 l-6,-8 Z" fill="var(--rd-surface)" stroke="${colors[t]}" stroke-width="2"/><text x="${x(s.p10_pct)}" y="${yy-17}" text-anchor="middle">${pct(s.p10_pct)}</text><text x="${x(s.p90_pct)}" y="${yy-17}" text-anchor="middle">${pct(s.p90_pct)}</text>`;});return `<svg viewBox="0 0 ${w} ${h}" role="img" aria-label="10th to 90th percentile of realised returns, median and mean">${body}</svg>`;}
function card(data,state,t){const s=stats(data,state,t);return `<article class="wl-card"><div class="wl-card-head"><h2 style="color:${colors[t]}">${t}</h2><span class="wl-small">${s.n} ${state.sample==='all'?'daily readings':'separate windows'}${s.n>0&&s.n<20?' · small sample':''}</span></div><div class="wl-card-body">${!s.n?'<div class="wl-empty">No estimate: this level was not observed in the sample.</div>':`<div class="wl-stats"><div><strong class="${s.mean_pct>=0?'wl-up':'wl-down'}">${pct(s.mean_pct)}</strong><span>Mean next-week return</span></div><div><strong>${pct(s.median_pct)}</strong><span>Median next-week return</span></div><div><strong>${f(s.positive_pct,1)}%</strong><span>Weeks with a positive return</span></div></div><div class="wl-callout">Against all eligible days: <b>${f(s.excess_vs_all_pp,2,true)} pp</b> in mean return.<br>95% interval for this difference: <b>${interval(s,'excess_ci95',' pp')}</b>.</div><p style="margin-top:12px">Return-mean interval: ${interval(s)}. Negative weeks: ${f(s.negative_pct,1)}%; unchanged: ${f(s.flat_pct,1)}%.</p>`}</div></article>`;}
function mount(root,data,initial={}){const state={timing:'close',sample:'cross',level:30,...initial};function render(){const focused=root.contains(document.activeElement)?document.activeElement:null;const focusControl=focused?.dataset.control;const focusLevel=focused?.dataset.wlLevel;if(state.sample==='cross'&&!data.meta.thresholds.includes(state.level))state.level=30;const baseline=data.results.SPY[state.timing].baseline,baseQ=data.results.QQQ[state.timing].baseline,selected=stats(data,state,'SPY'),keys=state.sample==='cross'?data.meta.thresholds:data.meta.centers;if(!keys.includes(state.level))state.level=30;root.innerHTML=`<style>${css}</style><div class="wl"><div class="wl-head"><div><p class="wl-eyebrow">HISTORICAL EVENT STUDY / SPY + QQQ</p><h2 class="wl-title">What happens after fear or greed?</h2><p>New zone entries · next 5 US trading sessions · CNN signals ${data.meta.start} to ${data.meta.end} · ETF outcomes through ${data.meta.price_end||data.meta.end} · Bloomberg total returns.</p></div><button class="wl-btn" data-action="export">Export selected observations ↓</button></div><div class="wl-controls"><label>Sample <select data-control="sample"><option value="cross">Extreme approaches · new threshold crossings</option><option value="episode">Diagnostic · first entries into all bands</option><option value="all">Diagnostic · every daily reading</option></select></label><label>Return timing <select data-control="timing"><option value="close">Reading-day close → 5 sessions later</option><option value="delayed">Next-session close → hold 5 sessions</option></select></label></div><div class="wl-summary">${(data.meta.primary_thresholds||[20,30,70,80]).map(c=>{const a=stats(data,state,'SPY',c),b=stats(data,state,'QQQ',c);return `<button class="wl-tile" data-wl-level="${c}" data-tone="${c<=30?'fear':'greed'}" aria-pressed="${state.level===c}"><span class="wl-selected">SELECTED</span><span class="wl-threshold-label">${state.sample==='cross'?(c<=30?'Fear threshold':'Greed threshold'):'CNN band'}</span><strong>${state.sample==='cross'?(c<=30?'≤':'≥'):''}${c}<span style="font-size:14px;color:var(--rd-muted)"> / 100</span></strong><small>${state.sample==='cross'?'New extreme-zone entry':'Band '+label(c)} · ${a.n} observations</small><p>${a.n?`<span>SPY<b>${pct(a.mean_pct)}</b></span><span>QQQ<b>${pct(b.mean_pct)}</b></span>`:'No observations<br>No extrapolation'}</p></button>`;}).join('')}</div><div class="wl-baseline"><span>Normal 5-session performance<br><small>All eligible daily readings · ${baseline.n} observations</small></span><span>SPY <b>${pct(baseline.mean_pct)}</b> · up ${f(baseline.positive_pct,1)}%</span><span>QQQ <b>${pct(baseQ.mean_pct)}</b> · up ${f(baseQ.positive_pct,1)}%</span></div><article class="wl-card"><div class="wl-card-head"><div><h2>${state.sample==='cross'?'Following week after entering an extreme zone':'Return in the following week, by starting level'}</h2><p>Click a level to inspect the distribution, hit rate and sample size.</p></div><div class="wl-legend"><span><i style="background:${colors.SPY}"></i>SPY</span><span><i style="background:${colors.QQQ}"></i>QQQ</span><span>Whiskers: 95% interval of the mean</span></div></div><div class="wl-card-body wl-chart">${barChart(data,state)}</div><div class="wl-note">${state.sample==='all'?'Counts include consecutive days and overlapping future weeks. Use first entries to avoid repeatedly counting the same band visit.':'New entries/crossings are selected chronologically; a new holding window cannot start before the prior selected window ends within the same band/threshold. Days remaining inside a zone are not new events. A move through 30 then 20 (or 70 then 80) is a deeper extreme in the same phase; do not add these counts as independent episodes.'} Pale bars: fewer than 20 observations. Intervals suppressed below 10 observations.</div></article><div class="wl-head"><div><h2>${state.sample==='cross'?'Crossing '+(state.level<=30?'down to ≤':'up to ≥')+state.level:'Near '+state.level+' · band '+label(state.level)}</h2><p>${selected.n?'Observed outcomes, not a forecast for the next occurrence.':'No history supports an estimate at this level.'}</p></div><label>Inspect level <select data-control="level">${keys.map(c=>`<option value="${c}">${c} ${state.sample==='cross'?'threshold':'· '+label(c)}</option>`).join('')}</select></label></div><div class="wl-split">${card(data,state,'SPY')}${card(data,state,'QQQ')}</div><article class="wl-card"><div class="wl-card-head"><div><h2>How wide was the range of outcomes?</h2><p>Central 80% of realised 5-session returns. These are outcome percentiles, not confidence intervals.</p></div><div class="wl-legend"><span>● Median</span><span>◇ Mean</span><span>Line: 10th–90th percentile</span></div></div><div class="wl-card-body wl-chart">${distribution(data,state)}</div></article><article class="wl-card"><div class="wl-card-head"><div><h2>Does the selected level behave the same across years?</h2><p>Exclude outcomes that cross a year-end. Small annual cells are descriptive only.</p></div></div><div class="wl-scroll"><table><thead><tr><th>Year</th><th>n</th><th>SPY mean</th><th>SPY up</th><th>QQQ mean</th><th>QQQ up</th></tr></thead><tbody>${selected.yearly.map((s,i)=>{const q=stats(data,state,'QQQ').yearly[i];return `<tr><td>${s.year}</td><td>${s.n}</td><td>${pct(s.mean_pct)}</td><td>${s.n?f(s.positive_pct,1)+'%':'—'}</td><td>${pct(q.mean_pct)}</td><td>${q.n?f(q.positive_pct,1)+'%':'—'}</td></tr>`;}).join('')}</tbody></table></div></article><div class="wl-callout warn wl-gap">A positive conditional return is not enough: compare it with the market's normal positive drift. Check whether the advantage over normal market drift survives uncertainty and the delayed-entry control. ${data.results.SPY[state.timing].groups.all_90.n===0?'No observations near 90; sample maximum '+f(data.meta.observed_max,2)+'.':''}</div><details><summary>Timing, definitions and sources</summary><p><b>Retained history is reused; changing a view does not collect new data.</b></p><p><b>Five sessions means one trading week</b>, not five calendar days or a fixed Monday–Friday week. Default return: total-return index at t+5 divided by its reading-date close at t, minus one. This is a descriptive event study; the historical CNN file does not establish availability before that close. The delayed-entry control enters at t+1 close and exits at t+6 close.</p><p>Near 30 means 25 ≤ CNN &lt;35. Other centered bands use the same ±5 points; only the last band includes 100. First entries can arrive from either side. Directed crossings are different: prior CNN above 20/30, current at or below it; or prior below 70/80/90, current at or above it. The 20/30 and 70/80 cutoffs are operational watch zones, distinct from CNN’s official category boundaries. A missing prior reading cannot establish a new entry.</p><p>Intervals: 1,000 circular moving-block resamples, 20 ETF sessions per block, retaining missing CNN dates on the original calendar. Not adjusted for comparisons across bands. History is retrospective and may be revised; no causal or executable-strategy claim. Gross total returns include dividends and exclude trading costs.</p><p><a class="wl-link" href="https://www.cnn.com/markets/fear-and-greed" target="_blank" rel="noopener noreferrer">CNN official index ↗</a> · ETF series: Bloomberg Desktop API, TOT_RETURN_INDEX_GROSS_DVDS. Data through ${data.meta.end}; last primary signal with a full outcome: ${data.meta.signal_end}. Current day and all earlier-than-2021 history are outside this sample.</p></details></div>`;
root.querySelectorAll('[data-control]').forEach(e=>{e.value=state[e.dataset.control];e.onchange=()=>{state[e.dataset.control]=e.dataset.control==='level'?+e.value:e.value;if(state.sample==='cross'&&!data.meta.thresholds.includes(state.level))state.level=30;render();};});root.querySelectorAll('[data-wl-level]').forEach(e=>{e.onclick=()=>{state.level=+e.dataset.wlLevel;render();};e.onkeydown=ev=>{if(ev.key==='Enter'||ev.key===' '){ev.preventDefault();state.level=+e.dataset.wlLevel;render();}};});root.querySelector('[data-action="export"]').onclick=()=>{const key=state.sample+'_'+state.level,rows=[['ticker','signal_date','cnn_level','entry_date','exit_date','total_return_5_sessions_pct','timing','sample']];for(const t of ['SPY','QQQ'])for(const r of data.observations[t][state.timing])if(r.groups.includes(key))rows.push([t,r.date,r.fg,r.entry_date,r.exit_date,r.return_pct,state.timing,key]);const csv=rows.map(r=>r.map(v=>'"'+String(v).replaceAll('"','""')+'"').join(',')).join('\r\n'),url=URL.createObjectURL(new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'})),a=document.createElement('a');a.href=url;a.download='cnn-'+state.level+'-next-week-'+state.sample+'-'+state.timing+'.csv';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);};
if(focusControl)root.querySelector(`[data-control="${focusControl}"]`)?.focus({preventScroll:true});
else if(focusLevel)root.querySelector(`button[data-wl-level="${focusLevel}"]`)?.focus({preventScroll:true});
}render();}
global.WeeklyLevels={mount,barChart,distribution,stats,css};
if(typeof module!=='undefined')module.exports=global.WeeklyLevels;
})(globalThis);

/* Shared pure rendering for the offline study, stock cards and Node checks. */
'use strict';
const ScoreReturns = (() => {
  const esc = v => String(v ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const number = (v, digits=1) => Number.isFinite(v) ? v.toLocaleString('en-US', {minimumFractionDigits:digits, maximumFractionDigits:digits}) : '—';
  const pct = v => Number.isFinite(v) ? `${v > 0 ? '+' : ''}${number(v)}%` : '—';
  const pp = v => Number.isFinite(v) ? `${v > 0 ? '+' : ''}${number(v)} pp` : '—';
  const sign = v => Number.isFinite(v) ? (v >= 0 ? 'sr-positive' : 'sr-negative') : '';
  const range = s => s?.n ? `${pct(s.p10)} to ${pct(s.p90)}` : '—';
  const status = s => !s?.n ? 'No completed analogs' : s.n < 20 ? 'Thin sample · descriptive only' : 'Historical analog · not a forecast';

  function currentOutcomes(company, results) {
    if (company.band == null) return '';
    return `<div class="sr-kpis" aria-label="Current score band: own-stock historical outcomes">${[5,10].map(h=>{
      const s=results[String(h)].bands[company.band], enough=s.n>=10;
      return `<div><span>${h===5?'1 week · 5-session hold':'2 weeks · 10-session hold'}</span><strong class="${enough?sign(s.mean):''}">${enough?pct(s.mean):'Insufficient history'}</strong><p>${enough?'Historical mean · median '+pct(s.median):'Fewer than 10 completed observations'}</p><p>Up ${enough?number(s.up_pct,0)+'%':'—'} · N=${s.n}</p>${enough?`<p>P10–P90: ${range(s)}</p><p>vs own all-band mean: ${pp(s.vs_baseline)}</p>`:''}<small>${status(s)}</small></div>`;
    }).join('')}</div>`;
  }

  function preview(data, ticker) {
    const c = data?.companies?.[ticker];
    if (!c) return '';
    return `<article class="card section-space sr-inline"><div class="card-head"><div><h2>Score → subsequent returns</h2><p>${esc(ticker)}'s own historical analogs · prices through ${esc(data.meta.price_asof)}</p></div><a class="btn" href="score-returns.html#ticker=${encodeURIComponent(ticker)}">Explore all score bands →</a></div><div class="card-body"><p>${c.band == null ? 'The current score is unavailable; no neutral score or return estimate is substituted.' : `Current attention &amp; sentiment score <b>${number(c.score)} / 100</b> · band <b>${esc(data.meta.bands[c.band])}</b>.`}</p>${currentOutcomes(c,c.results.all)}<p class="inline-note">Entry at the next session's close. The score includes attention as well as tone; specialist-sales judgments are not backfilled into its history. P10–P90 shows historical dispersion; these are observed conditional returns, not expected-return forecasts. <a href="score-returns.html#ticker=${encodeURIComponent(ticker)}">View all score bands, confidence intervals and 2026 stability.</a></p></div></article>`;
  }

  function chart(result, selectedBand, horizon, bands) {
    const rows = result.bands;
    const vals = rows.flatMap(s=>[s.mean,...(s.ci95||[])]).filter(Number.isFinite);
    vals.push(result.baseline.mean||0,0);
    let lo=Math.min(...vals), hi=Math.max(...vals), pad=Math.max(1,(hi-lo)*.16);
    lo-=pad; hi+=pad;
    const w=620,h=310,l=62,r=22,t=30,b=56;
    const x=i=>l+(i+.5)*(w-l-r)/5, y=v=>t+(hi-v)/(hi-lo)*(h-t-b);
    let body='';
    if (selectedBand!=null) body+=`<rect x="${x(selectedBand)-43}" y="${t}" width="86" height="${h-t-b}" rx="10" fill="#729cff" opacity=".09"/>`;
    for(let i=0;i<=4;i++){
      const v=lo+(hi-lo)*i/4;
      body+=`<line x1="${l}" x2="${w-r}" y1="${y(v)}" y2="${y(v)}" stroke="#293a50"/><text x="${l-10}" y="${y(v)+4}" text-anchor="end" fill="#9caec5" font-size="12">${pct(v)}</text>`;
    }
    body+=`<line x1="${l}" x2="${w-r}" y1="${y(0)}" y2="${y(0)}" stroke="#94a6be" opacity=".65"/>`;
    if(Number.isFinite(result.baseline.mean)) body+=`<line x1="${l}" x2="${w-r}" y1="${y(result.baseline.mean)}" y2="${y(result.baseline.mean)}" stroke="#e2b978" stroke-dasharray="5 5"/>`;
    rows.forEach((s,i)=>{
      const xx=x(i),col=s.mean>=0?'var(--rd-teal)':'var(--rd-red)';
      body+=`<text x="${xx}" y="${h-31}" text-anchor="middle" fill="#cfdaeb" font-size="12">${esc(bands[i])}</text><text x="${xx}" y="${h-12}" text-anchor="middle" fill="#9caec5" font-size="11">N=${s.n}</text>`;
      if(!s.n) return;
      const tip=`${bands[i]} | Mean ${pct(s.mean)} | 95% mean interval ${s.ci95?s.ci95.map(pct).join(' to '):'insufficient blocks'} | Median ${pct(s.median)} | Up ${number(s.up_pct)}% | N=${s.n}, ${s.dates} dates, ${s.stocks} stocks`;
      body+=`<g tabindex="0" role="img" aria-label="${esc(tip)}"><title>${esc(tip)}</title>`;
      if(s.ci95)body+=`<line x1="${xx}" x2="${xx}" y1="${y(s.ci95[0])}" y2="${y(s.ci95[1])}" stroke="${col}" stroke-width="2"/><path d="M${xx-7},${y(s.ci95[0])}h14 M${xx-7},${y(s.ci95[1])}h14" stroke="${col}" fill="none"/>`;
      body+=`<circle cx="${xx}" cy="${y(s.mean)}" r="6" fill="${col}" stroke="var(--rd-soft)" stroke-width="2"/><text x="${xx}" y="${Math.max(t+10,y(s.ci95?s.ci95[1]:s.mean)-11)}" text-anchor="middle" fill="${col}" font-size="13" font-weight="600">${pct(s.mean)}</text></g>`;
    });
    return `<svg viewBox="0 0 ${w} ${h}" role="img" aria-label="${horizon}-session mean subsequent return by score band, with 95 percent mean intervals"><title>Score and ${horizon}-session returns</title>${body}</svg>`;
  }

  function render(data, state) {
    const pooled=state.ticker==='universe', company=data.companies[state.ticker];
    const scope=pooled?data.pooled:company.results, results=scope[state.period];
    const currentBand=pooled?null:company.band;
    const label=pooled?'USD-quoted covered universe':state.ticker;
    const selected=currentBand==null?null:results['10'].bands[currentBand];
    const options=Object.keys(data.companies).sort().map(t=>`<option value="${esc(t)}" ${state.ticker===t?'selected':''}>${esc(t)} · ${esc(data.companies[t].name)}</option>`).join('');
    return `<div class="sr-header"><div><div class="sr-eyebrow">SENTIMENT RADAR / FORWARD RETURNS</div><h1>What followed a similar score?</h1><p>One- and two-week outcomes, measured after the signal. Higher scores do not automatically imply higher returns.</p></div><span class="sr-badge">Prices ${esc(data.meta.price_asof)}</span></div>
      <div class="sr-toolbar"><label>Company / reference universe<select data-sr="ticker"><option value="universe" ${pooled?'selected':''}>USD universe · pooled reference</option>${options}</select></label><label>Historical sample<select data-sr="period"><option value="all" ${state.period==='all'?'selected':''}>All retained history</option><option value="pre2026" ${state.period==='pre2026'?'selected':''}>2024–25 · completed by year-end</option><option value="2026" ${state.period==='2026'?'selected':''}>2026 · stability check</option></select></label><button class="sr-button" data-sr-export>Export table CSV ↓</button></div>
      <div class="sr-context"><div><b>${esc(label)}</b><p>${pooled?`${data.meta.sampled_usd_names} names with historical eligible scores. Event-weighted pooled reference; this is not an asset-specific forecast.`:company.band==null?'No current eligible score. Historical bands remain available.':`Current score <b>${number(company.score)} / 100</b> · band <b>${esc(data.meta.bands[company.band])}</b>. Highlighted band links today’s score to this asset’s own past observations.`}</p></div><div><span class="sr-label">${pooled?'Completed 2-week observations':'Current-band 2-week observations'}</span><strong>${pooled?results['10'].baseline.n:selected?.n||0}</strong><small>${pooled?`${results['10'].baseline.dates} signal dates; stocks on the same date are correlated`:status(selected)}</small></div></div>
      ${!pooled&&company.currency!=='USD'?`<div class="sr-note">${esc(company.currency)} price returns sampled on the retained US-session calendar. Local exchange sessions and time zones differ; QQQ-relative returns are omitted.</div>`:''}
      ${!pooled?currentOutcomes(company,results):''}
      <div class="sr-charts">${[5,10].map(h=>`<article class="sr-card"><div class="sr-card-head"><h2>${h===5?'1 week':'2 weeks'} <span>${h}-session hold</span></h2><p>Mean return · whiskers = 95% interval for the mean</p></div>${chart(results[String(h)],currentBand,h,data.meta.bands)}<div class="sr-chart-foot"><span class="sr-dash"></span>All-band mean ${pct(results[String(h)].baseline.mean)} <span>· same sample and horizon</span></div></article>`).join('')}</div>
      <article class="sr-card"><div class="sr-card-head"><h2>Score band → subsequent price return</h2><p>${esc(label)} · P10–P90 shows historical dispersion, not a future probability guarantee. Highlight = current score band.</p></div><div class="sr-scroll"><table class="sr-table"><thead><tr><th rowspan="2">Score / 100</th><th colspan="5">1 week · 5 sessions</th><th colspan="5">2 weeks · 10 sessions</th></tr><tr>${[5,10].map(()=>'<th>Mean</th><th>Median</th><th>Up</th><th>P10–P90</th><th>N</th>').join('')}</tr></thead><tbody>${data.meta.bands.map((name,i)=>`<tr class="${i===currentBand?'sr-current':''}"><th>${esc(name)}${i===currentBand?' <span>● current</span>':''}</th>${[5,10].map(h=>{const s=results[String(h)].bands[i];return `<td class="${sign(s.mean)}">${pct(s.mean)}</td><td>${pct(s.median)}</td><td>${s.n?number(s.up_pct,0)+'%':'—'}</td><td class="sr-range">${range(s)}</td><td title="${esc(status(s))}">${s.n}${s.n>0&&s.n<20?'*':''}</td>`;}).join('')}</tr>`).join('')}<tr class="sr-baseline"><th>All bands</th>${[5,10].map(h=>{const s=results[String(h)].baseline;return `<td>${pct(s.mean)}</td><td>${pct(s.median)}</td><td>${s.n?number(s.up_pct,0)+'%':'—'}</td><td class="sr-range">${range(s)}</td><td>${s.n}</td>`;}).join('')}</tr></tbody></table></div><p class="sr-foot">* Fewer than 20 outcomes: thin descriptive sample. Twenty observations is a display threshold, not proof of predictive reliability. Zero outcomes remain unavailable.</p></article>
      <div class="sr-bottom"><article class="sr-card"><div class="sr-card-head"><h2>Does it beat the reference?</h2><p>${pooled?'Same-date QQQ price returns, USD names only.':'Conditional mean minus all-band mean for this company; QQQ comparison only for USD prices.'}</p></div><div class="sr-scroll"><table class="sr-table"><thead><tr><th>Band</th><th>1w vs baseline</th><th>2w vs baseline</th><th>1w vs QQQ</th><th>2w vs QQQ</th></tr></thead><tbody>${data.meta.bands.map((b,i)=>`<tr class="${i===currentBand?'sr-current':''}"><th>${esc(b)}</th>${[5,10].map(h=>`<td>${pp(results[String(h)].bands[i].vs_baseline)}</td>`).join('')}${[5,10].map(h=>`<td>${pp(results[String(h)].bands[i].excess_qqq)}</td>`).join('')}</tr>`).join('')}</tbody></table></div><p class="sr-foot">A positive raw return can come from a rising market. These differences are descriptive, not risk-adjusted alpha or a causal effect.</p></article><article class="sr-card sr-method"><h2>Read the comparison correctly</h2><ol><li><b>Signal then return.</b> Score at t; enter at the close of t+1; exit at t+6 / t+11. The “week” starts at entry, not at the signal close.</li><li><b>No duplicated holding windows within a stock.</b> First valid score, then the next valid score at least 11 US sessions later. Both horizons share this sampling rule.</li><li><b>Three different measures.</b> The 0–100 score blends attention acceleration, unusual attention, improving tone and positive agreement. It is not pure X tone, CNN Fear &amp; Greed, or a spec-sales rating.</li><li><b>Uncertainty is visible.</b> Mean intervals resample 20-session calendar blocks with all stocks together. Individual return dispersion is much wider than uncertainty around an average.</li></ol><details><summary>Sources and limits</summary><p>${esc(data.meta.source)}. Retained price/score data through ${esc(data.meta.price_asof)}; first sampled signal ${esc(data.meta.signal_start)}.</p><p>Score weights: 35% acceleration, 30% unusual attention, 20% tone improvement, 15% positive-share rank. Historical specialist commentary is not numerically scored in this study.</p><p>${esc(data.meta.periods)}</p><p>${esc(data.meta.uncertainty)}</p><ul>${data.meta.limitations.map(s=>`<li>${esc(s)}</li>`).join('')}</ul></details></article></div>`;
  }

  function csv(data,state) {
    const results=(state.ticker==='universe'?data.pooled:data.companies[state.ticker].results)[state.period];
    const rows=[['scope','period','band','sessions','mean_pct','median_pct','up_pct','p10_pct','p90_pct','n','signal_dates','stocks','ci95_low','ci95_high','vs_baseline_pp','vs_qqq_pp']];
    for(const h of [5,10])results[String(h)].bands.forEach((s,i)=>rows.push([state.ticker,state.period,data.meta.bands[i],h,s.mean,s.median,s.up_pct,s.p10,s.p90,s.n,s.dates,s.stocks,s.ci95?.[0],s.ci95?.[1],s.vs_baseline,s.excess_qqq]));
    return rows.map(row=>row.map(v=>'"'+String(v??'').replaceAll('"','""')+'"').join(',')).join('\r\n');
  }

  function mount(root,data,initial={}) {
    const state={ticker:'universe',period:'all',...initial};
    if(state.ticker!=='universe'&&!data.companies[state.ticker])state.ticker='universe';
    const draw=()=>{
      root.innerHTML=render(data,state);
      root.querySelectorAll('[data-sr]').forEach(el=>el.onchange=()=>{state[el.dataset.sr]=el.value;draw();});
      root.querySelector('[data-sr-export]').onclick=()=>{
        const url=URL.createObjectURL(new Blob(['\ufeff'+csv(data,state)],{type:'text/csv;charset=utf-8'}));
        const a=document.createElement('a');a.href=url;a.download=`score-returns-${state.ticker}-${state.period}.csv`;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);
      };
    }; draw();
  }
  return {render,preview,chart,csv,mount};
})();
if(typeof module!=='undefined')module.exports=ScoreReturns;

'use strict';
// Pure chart transforms also run in Node for numerical verification.
const ChartMath={
  finite:v=>typeof v==='number'&&Number.isFinite(v),
  scale:(a,b,c,d)=>v=>c+(v-a)/(b-a||1)*(d-c),
  path(values,x,y){let pen=false;return values.map((v,i)=>{if(!this.finite(v)){pen=false;return '';}const s=`${pen?'L':'M'}${x(i).toFixed(2)},${y(v).toFixed(2)}`;pen=true;return s;}).join(' ');},
  indexed(values){const base=values.find(v=>this.finite(v)&&v>0);return values.map(v=>this.finite(v)&&base?v/base*100:null);},
  extent(values,zero=false){const a=values.filter(this.finite);if(!a.length)return [0,1];let lo=Math.min(...a),hi=Math.max(...a);if(zero){lo=Math.min(lo,0);hi=Math.max(hi,0);}const pad=(hi-lo||Math.abs(hi)||1)*.09;return [lo-pad,hi+pad];},
  correlation(x,y){const pairs=x.map((v,i)=>[v,y[i]]).filter(p=>p.every(this.finite));if(pairs.length<3)return null;const n=pairs.length,mx=pairs.reduce((s,p)=>s+p[0],0)/n,my=pairs.reduce((s,p)=>s+p[1],0)/n;let a=0,b=0,c=0;for(const p of pairs){a+=(p[0]-mx)*(p[1]-my);b+=(p[0]-mx)**2;c+=(p[1]-my)**2;}return b&&c?a/Math.sqrt(b*c):null;}
};
if(typeof module!=='undefined')module.exports=ChartMath;
if(typeof document!=='undefined') (async()=>{
const $=id=>document.getElementById(id),q=(s,e=document)=>e.querySelector(s),qa=(s,e=document)=>[...e.querySelectorAll(s)];
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const num=(v,n=1,sign=false)=>ChartMath.finite(v)?(sign&&v>0?'+':'')+v.toLocaleString('en-US',{minimumFractionDigits:n,maximumFractionDigits:n}):'—';
const pct=(v,n=1)=>ChartMath.finite(v)?num(v,n,true)+'%':'—';
const cls=v=>v==null?'muted':v>=0?'up':'down';
const date=d=>d?new Date(d.slice(0,10)+'T12:00:00Z').toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric',timeZone:'UTC'}):'—';
const shortDate=d=>d?new Date(d.slice(0,10)+'T12:00:00Z').toLocaleDateString('en-GB',{day:'2-digit',month:'short',timeZone:'UTC'}):'—';
const color={blue:'var(--rd-blue)',teal:'var(--rd-teal)',red:'var(--rd-red)',muted:'#94aac9',ink:'var(--rd-ink)',amber:'var(--rd-amber)'};
const safeURL=u=>/^(https:\/\/|outlook:)/i.test(u||'')?esc(u):'#';
const link=(u,label)=>`<a href="${safeURL(u)}" target="_blank" rel="noopener noreferrer">${esc(label)} ↗</a>`;
const seg=(group,items,selected)=>`<div class="seg" aria-label="${esc(group)}">${items.map(([v,t])=>`<button data-group="${group}" data-value="${v}" aria-pressed="${String(v)===String(selected)}">${t}</button>`).join('')}</div>`;
const metric=(label,value,note)=>`<div class="metric"><div class="metric-label">${label}</div><div class="metric-value number">${value}</div><div class="metric-note">${note}</div></div>`;
const svg=(w,h,label,body)=>`<svg viewBox="0 0 ${w} ${h}" role="img" aria-label="${esc(label)}"><title>${esc(label)}</title>${body}</svg>`;
let D,S={view:'radar',rank:'pressure_change',map:'pressure_change',ticker:'META',period:126,tableFilter:'eligible',tableSearch:'',marketSection:'weekly',marketTicker:'SPY',marketMode:'same',horizon:20,marketPeriod:252,topic:'META_MUSE',deskFilter:'all'};
function tip(html,e){const t=$('tooltip');t.innerHTML=html;t.hidden=false;const r=e.currentTarget?.getBoundingClientRect?.();const x=e.clientX||r?.left||20,y=e.clientY||r?.top||20;t.style.left=Math.max(8,Math.min(x+16,innerWidth-310))+'px';t.style.top=Math.max(8,Math.min(y+14,innerHeight-t.offsetHeight-12))+'px';}
function hideTip(){$('tooltip').hidden=true;}
function bindTips(root=document){qa('[data-tip]',root).forEach(e=>{e.onpointerenter=e.onpointermove=ev=>tip(e.dataset.tip,ev);e.onpointerleave=hideTip;e.onfocus=ev=>tip(e.dataset.tip,ev);e.onblur=hideTip;});}
function stockRows(t){return D.stocks[t].rows.map(r=>Object.fromEntries(D.fields.map((f,i)=>[f,r[i]])));}
function openStock(t){if(!D.stocks[t])return;S.ticker=t;showView('stock');}
function bindStockLinks(root){qa('[data-stock]',root).forEach(e=>{e.onclick=()=>openStock(e.dataset.stock);if(e.tagName.toLowerCase()==='circle')e.onkeydown=ev=>{if(ev.key==='Enter'||ev.key===' '){ev.preventDefault();openStock(e.dataset.stock);}};});}
function showView(view){S.view=view;hideTip();qa('.view').forEach(e=>e.hidden=e.id!=='view-'+view);qa('[data-view]').forEach(e=>{e.setAttribute('aria-selected',String(e.dataset.view===view));e.tabIndex=e.dataset.view===view?0:-1;});({radar:renderRadar,stock:renderStock,market:renderMarket,narrative:renderNarrative,method:renderMethod}[view])();}
function lineChart(dates,series,{height=210,title='',domain=null,zero=false,format=v=>num(v,0),bands=[],markers=[],id=''}={}){
 const w=920,l=68,r=22,t=33,b=32,x=ChartMath.scale(0,Math.max(1,dates.length-1),l,w-r);const [lo,hi]=domain||ChartMath.extent(series.flatMap(s=>s.values),zero);const y=ChartMath.scale(lo,hi,height-b,t);let body=`<text x="${l}" y="17" class="axis-title">${esc(title)}</text>`;
 for(const band of bands){body+=`<rect x="${l}" y="${y(band.hi)}" width="${w-l-r}" height="${y(band.lo)-y(band.hi)}" fill="${band.color}"/>`;}
 for(let i=0;i<4;i++){const v=lo+(hi-lo)*i/3,yy=y(v);body+=`<line x1="${l}" x2="${w-r}" y1="${yy}" y2="${yy}" stroke="var(--rd-grid)"/><text x="${l-10}" y="${yy+4}" text-anchor="end">${esc(format(v))}</text>`;}
 if(lo<0&&hi>0)body+=`<line x1="${l}" x2="${w-r}" y1="${y(0)}" y2="${y(0)}" stroke="#bdcbd9" stroke-dasharray="4 4"/>`;
 for(let k=0;k<5;k++){const i=Math.round((dates.length-1)*k/4);body+=`<text x="${x(i)}" y="${height-8}" text-anchor="${k===0?'start':k===4?'end':'middle'}">${shortDate(dates[i])}${dates.length>300?' '+dates[i]?.slice(2,4):''}</text>`;}
 for(const m of markers){const i=dates.indexOf(m.date);if(i>=0)body+=`<line x1="${x(i)}" x2="${x(i)}" y1="${t}" y2="${height-b}" stroke="#a5b9cf" stroke-dasharray="3 4"/><circle cx="${x(i)}" cy="${t+6}" r="9" fill="var(--rd-soft)"/><text x="${x(i)}" y="${t+10}" text-anchor="middle" style="fill:var(--rd-ink);font-size:11px">${esc(m.tag)}</text>`;}
 for(const s of series){if(s.bar){const width=Math.max(.6,(w-l-r)/dates.length*.66);s.values.forEach((v,i)=>{if(ChartMath.finite(v))body+=`<rect x="${x(i)-width/2}" y="${y(Math.max(v,0))}" width="${width}" height="${Math.max(.4,Math.abs(y(v)-y(0)))}" rx="1" fill="${s.color}" opacity=".64"/>`;});}else{body+=`<path d="${ChartMath.path(s.values,x,y)}" fill="none" stroke="${s.color}" stroke-width="${s.width||2.5}" stroke-linejoin="round" stroke-linecap="round"${s.dash?' stroke-dasharray="5 4"':''}/>`;}}
 if(id)body+=`<line class="crosshair" x1="${l}" x2="${l}" y1="${t}" y2="${height-b}" stroke="var(--rd-muted)" stroke-dasharray="3 3" visibility="hidden"/><rect data-hover-chart="${id}" x="${l}" y="${t}" width="${w-l-r}" height="${height-t-b}" fill="transparent"/>`;
 return svg(w,height,title,body);
}
function ranks(){const v=D.highlights.views[S.rank];const pressure=S.rank==='pressure_change';const all=[...v.up,...v.down];const bound=pressure?100:Math.max(.1,...all.flatMap(r=>[Math.abs(r.tone),Math.abs(r.tone_prior||0)]))*1.15;const scale=ChartMath.scale(pressure?0:-bound,bound,5,125);return ['up','down'].map(dir=>`<div class="rank-group"><div class="rank-title"><span>${dir==='up'?(S.rank==='tone'?'Most positive':'Rising'):(S.rank==='tone'?'Most negative':'Falling')}</span><span>Δ / level &nbsp; Price 5d</span></div>${v[dir].map(r=>{const a=pressure?r.pressure_prior:r.tone_prior,b=pressure?r.pressure:r.tone,c=color[dir==='up'?'teal':'red'];return `<button class="rank-row" data-stock="${esc(r.ticker)}" aria-label="Open ${esc(r.ticker)}; ${num(r[S.rank],pressure?1:3,true)}"><strong>${esc(r.ticker)}</strong><span class="rank-track"><svg viewBox="0 0 130 22" aria-hidden="true"><line x1="5" x2="125" y1="11" y2="11" stroke="var(--rd-grid)" stroke-width="3"/><line x1="${scale(a)}" x2="${scale(b)}" y1="11" y2="11" stroke="${c}" stroke-width="3"/><circle cx="${scale(a)}" cy="11" r="3.5" fill="var(--rd-surface)" stroke="${c}"/><circle cx="${scale(b)}" cy="11" r="4" fill="${c}"/></svg></span><span class="rank-change ${dir}">${num(r[S.rank],pressure?1:3,true)}</span><span class="rank-return">${pct(r.price_return5_pct)}</span></button>`;}).join('')||'<div class="empty">No eligible names.</div>'}</div>`).join('');}
function mapRows(){return Object.entries(D.stocks).map(([ticker,s])=>({ticker,...s})).filter(s=>s.eligible&&ChartMath.finite(s[S.map])&&ChartMath.finite(s.return5));}
function radarMap(){const rows=mapRows(),w=790,h=488,l=64,r=24,t=35,b=65;const [xlo,xhi]=ChartMath.extent(rows.map(s=>s.return5),true);const lim=S.map==='pressure_change'?100:Math.max(.05,...rows.map(s=>Math.abs(s[S.map])))*1.22;const x=ChartMath.scale(xlo,xhi,l,w-r),y=ChartMath.scale(-lim,lim,h-b,t);let body='';
 const zx=x(0),zy=y(0);body+=`<rect x="${l}" y="${t}" width="${zx-l}" height="${zy-t}" fill="var(--rd-blue-wash)"/><rect x="${zx}" y="${zy}" width="${w-r-zx}" height="${h-b-zy}" fill="var(--rd-red-wash)"/>`;
 for(let k=0;k<5;k++){let v=xlo+(xhi-xlo)*k/4;body+=`<line x1="${x(v)}" x2="${x(v)}" y1="${t}" y2="${h-b}" stroke="var(--rd-grid)"/><text x="${x(v)}" y="${h-b+24}" text-anchor="middle">${pct(v,0)}</text>`;v=-lim+2*lim*k/4;body+=`<line x1="${l}" x2="${w-r}" y1="${y(v)}" y2="${y(v)}" stroke="var(--rd-grid)"/><text x="${l-10}" y="${y(v)+4}" text-anchor="end">${num(v,S.map==='pressure_change'?0:2,true)}</text>`;}
 body+=`<line x1="${zx}" x2="${zx}" y1="${t}" y2="${h-b}" stroke="#9cafc4" stroke-dasharray="4 4"/><line x1="${l}" x2="${w-r}" y1="${zy}" y2="${zy}" stroke="#9cafc4" stroke-dasharray="4 4"/><text x="${l}" y="18" class="axis-title">${S.map==='pressure_change'?'Change in attention score · 5 sessions':'Change in sentiment · 5 sessions'}</text><text x="${w/2}" y="${h-12}" text-anchor="middle" class="axis-title">Stock return · same 5 sessions</text><text class="quad" x="${l+12}" y="${t+21}" style="fill:#a1c3ff">Discussion ↑ · Price ↓</text><text class="quad" x="${w-r-12}" y="${h-b-16}" text-anchor="end" style="fill:#e5a4b7">Discussion ↓ · Price ↑</text>`;
 const labels=new Set([...D.highlights.views[S.map].up.slice(0,3),...D.highlights.views[S.map].down.slice(0,2)].map(r=>r.ticker));['CRM','GLW','META'].forEach(t=>labels.add(t));const placed=[];
 for(const s of rows.sort((a,b)=>b.current.mentions5-a.current.mentions5)){const xx=x(s.return5),yy=y(s[S.map]),radius=Math.max(4.5,Math.min(16,3+Math.sqrt(s.current.mentions5/100))),c=s.tone_change5>=0?color.teal:color.red,authors=s.curated.curated_authors7||0;const detail=`<strong>${esc(s.ticker)}</strong><small> · ${esc(s.name)}</small><div class="tip-row">Attention-score change <b>${num(s.pressure_change,1,true)}</b></div><div class="tip-row">Sentiment change <b>${num(s.tone_change5,3,true)}</b></div><div class="tip-row">Stock return <b>${pct(s.return5)}</b></div><div class="tip-row">X mentions / 5d <b>${num(s.current.mentions5,0)}</b></div><div class="tip-foot">${authors} collected non-news authors / 7d${authors<3?' · Sparse confirmation':''}<br>Click to inspect the time series.</div>`;body+=`<circle class="hit point-button" tabindex="0" role="button" aria-label="Open ${s.ticker}" data-stock="${s.ticker}" data-tip="${esc(detail)}" cx="${xx}" cy="${yy}" r="${radius}" fill="${c}" fill-opacity="${authors>=3?.68:.18}" stroke="${c}" stroke-width="1.1"/>`;
 if(labels.has(s.ticker)){let lx=xx+radius+5,ly=yy-7;if(lx+47>w-r)lx=xx-radius-49;for(let i=0;i<7&&placed.some(p=>Math.abs(p.x-lx)<52&&Math.abs(p.y-ly)<17);i++)ly+=18;ly=Math.min(h-b-8,Math.max(t+38,ly));placed.push({x:lx,y:ly});body+=`<text class="label" x="${lx}" y="${ly}">${s.ticker}</text>`;}}
 return svg(w,h,'Price versus change in discussion. Select a company to investigate.',body);
}
function renderRadar(){const H=D.highlights,rows=mapRows(),rising=rows.filter(s=>s.pressure_change>0).length,falling=rows.filter(s=>s.pressure_change<0).length,cnn=D.market?.meta.current;const root=$('view-radar');root.innerHTML=`<div class="view-head"><div><h1>Where is the conversation moving?</h1><p>${date(H.meta.comparison_date)} → ${date(H.meta.asof)} · Compare discussion with price, then inspect the evidence.</p></div><span class="tag blue">5-session radar</span></div><div class="metrics">${metric('CNN Fear & Greed',cnn?num(cnn.score,1)+' <span class="unit">/ 100 · '+esc(cnn.rating)+'</span>':'—',cnn?`Latest ${date(cnn.timestamp)} · ${num(cnn.score-cnn.previous_close,1,true)} vs prior close<div class="gauge"><span style="background:var(--rd-red)"></span><span style="background:#d59f62"></span><span style="background:#b7c4d3"></span><span style="background:#70b6a7"></span><span style="background:var(--rd-teal)"></span><b style="left:${cnn.score}%"></b></div>`:'Unavailable')}${metric('Comparable attention scores',`${H.views.pressure_change.eligible} <span class="unit">/ ${H.meta.universe} names</span>`,'Two complete windows · ≥25 mentions in each')}${metric('Attention-score breadth',`${rising} <span class="unit">rising / ${falling} falling</span>`,'Research score · not observed fund flows')}${metric('Original X-post coverage',shortDate(H.meta.collected_posts_through),`Last complete day · user-collected account sample`)}</div><div class="radar-grid"><article class="card"><div class="card-head"><div><h2>Discussion × price</h2><p>Divergences are research prompts, not trade recommendations.</p></div>${seg('map',[['pressure_change','Attention score'],['tone_change5','Sentiment']],S.map)}</div><div class="card-body"><div class="legend"><span><i style="background:${color.teal}"></i>Sentiment improving</span><span><i style="background:${color.red}"></i>Sentiment deteriorating</span><span><i class="hollow"></i>&lt;3 collected authors</span></div><div class="chart" id="radar-map">${radarMap()}</div></div><div class="chart-note">Bubble size: vendor mention volume, capped for readability. Both axes cover the same period; this is not a lead–lag test. Click any name.</div></article><article class="card" id="highlights"><div class="card-head"><div><h2>Five up. Five down.</h2><p>Rank the change separately from the tone level.</p></div></div><div class="chart-tabs"><select id="rank-mode" class="control" aria-label="Rank names by"><option value="pressure_change">Attention score · change in points</option><option value="tone_change5">Sentiment · change</option><option value="tone">Sentiment · current level</option></select></div><div id="rank-content">${ranks()}</div><div class="rank-foot">○ Previous reading &nbsp; ● Current reading<br>Falling attention score can coexist with positive sentiment.</div></article></div><div class="insight-grid" id="radar-insights">${insights()}</div><article class="card section-space"><div class="table-top"><div><h2>Explore the universe</h2><small id="table-count"></small></div><div class="toolbar"><input id="table-search" class="control" placeholder="Find a ticker or company" aria-label="Find a ticker or company" value="${esc(S.tableSearch)}"><select id="table-filter" class="control" aria-label="Universe coverage"><option value="eligible">Comparable attention scores</option><option value="all">All 106 names</option></select><button class="btn" id="export-universe">Export CSV ↓</button></div></div><div class="table-wrap" id="universe-table"></div></article>`;
 $('rank-mode').value=S.rank;$('rank-mode').onchange=e=>{S.rank=e.target.value;$('rank-content').innerHTML=ranks();bindStockLinks($('rank-content'));};qa('[data-group="map"]',root).forEach(b=>b.onclick=()=>{S.map=b.dataset.value;renderRadar();});$('table-filter').value=S.tableFilter;$('table-filter').onchange=e=>{S.tableFilter=e.target.value;renderTable();};$('table-search').oninput=e=>{S.tableSearch=e.target.value;renderTable();};$('export-universe').onclick=exportUniverse;bindStockLinks(root);bindTips(root);renderTable();}
function insights(){let a=Object.entries(D.stocks).filter(([,s])=>s.eligible&&s.pressure_change>0&&s.return5<0).sort((a,b)=>b[1].pressure_change-a[1].pressure_change)[0],b=Object.entries(D.stocks).filter(([,s])=>s.eligible&&s.tone_change5<0&&s.return5>0).sort((a,b)=>a[1].tone_change5-b[1].tone_change5)[0],c=D.highlights.views.pressure_change.up[0];return [a?`<button class="insight" data-stock="${a[0]}"><div class="eyebrow">Divergence to investigate</div><h3>${a[0]} · Discussion up, price down ↗</h3><p>Attention score ${num(a[1].pressure_change,1,true)} pts; stock ${pct(a[1].return5)}. Check whether the debate reflects conviction, controversy or a new catalyst.</p></button>`:'',b?`<button class="insight" data-stock="${b[0]}"><div class="eyebrow">Price ahead of sentiment</div><h3>${b[0]} · Rally with softer tone ↗</h3><p>Stock ${pct(b[1].return5)}; tone ${num(b[1].tone_change5,3,true)}. A disagreement to review, not proof that the rally will reverse.</p></button>`:'',c?`<button class="insight" data-stock="${c.ticker}"><div class="eyebrow">Largest attention-score increase</div><h3>${c.ticker} · Attention accelerating ↗</h3><p>${num(c.attention_ratio,1)}× prior attention baseline; ${num(c.curated_authors,0)} collected non-news authors. Inspect breadth before calling it consensus.</p></button>`:''].join('');}
function tableRows(){return Object.entries(D.stocks).filter(([t,s])=>(S.tableFilter==='all'||s.eligible&&s.pressure_change!=null)&&(!S.tableSearch||(t+' '+s.name).toLowerCase().includes(S.tableSearch.toLowerCase()))).sort((a,b)=>(b[1].pressure_change??-Infinity)-(a[1].pressure_change??-Infinity));}
function renderTable(){const rows=tableRows();$('table-count').textContent=`${rows.length} names · sorted by attention-score change`; $('universe-table').innerHTML=`<table><thead><tr><th>Name</th><th class="numeric">Attention score Δ 5d</th><th class="numeric">Sentiment Δ 5d</th><th class="numeric">Price 5d</th><th class="numeric">Mentions 5d</th><th class="numeric">Authors 7d</th><th>Coverage</th></tr></thead><tbody>${rows.map(([t,s])=>`<tr><td><button class="ticker-link" data-stock="${t}">${t}</button><div class="name-cell">${esc(s.name)}</div></td><td class="numeric ${cls(s.pressure_change)}">${num(s.pressure_change,1,true)}</td><td class="numeric ${cls(s.tone_change5)}">${num(s.tone_change5,3,true)}</td><td class="numeric ${cls(s.return5)}">${pct(s.return5)}</td><td class="numeric">${num(s.current.mentions5,0)}</td><td class="numeric">${num(s.curated.curated_authors7,0)}</td><td><span class="tag ${s.eligible&&s.pressure_change!=null?(s.curated.curated_authors7>=3?'green':'amber'):''}">${!s.eligible||s.pressure_change==null?'Not rank-eligible':s.curated.curated_authors7>=3?'3+ collected authors':'Sparse source breadth'}</span></td></tr>`).join('')||'<tr><td colspan="7" class="empty">No matching companies.</td></tr>'}</tbody></table>`;bindStockLinks($('universe-table'));}
function download(name,rows){const quote=v=>'"'+String(v??'').replaceAll('"','""')+'"';const text=rows.map(r=>r.map(quote).join(',')).join('\r\n'),blob=new Blob(['\ufeff'+text],{type:'text/csv;charset=utf-8'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);}
function exportUniverse(){download('crowding-universe-'+D.meta.price_asof+'.csv',[['ticker','name','rank_eligible','pressure_change_5d','tone_change_5d','price_return_5d_pct','mentions_5d','collected_non_news_authors_7d','data_date'],...tableRows().map(([t,s])=>[t,s.name,s.eligible&&s.pressure_change!=null,s.pressure_change,s.tone_change5,s.return5,s.current.mentions5,s.curated.curated_authors7,D.meta.price_asof])]);}
// Secondary views are filled from the same snapshot, never from a live request.
function specialistPreview(ticker){const c=D.specialist?.companies?.[ticker];if(!c)return '';const s=D.specialist.sources[c.summary_source];return `<article class="card section-space"><div class="card-head"><div><h2>Specialist sales · contextual review</h2><p>${esc(c.coverage)} · ${c.notes} reviewed emails · ${c.houses.length} houses · ${date(c.latest)}</p></div><a class="btn" href="specialist-sales.html#ticker=${ticker}">Full desk comparison →</a></div><div class="card-body"><div class="legend"><b>${esc(c.tone)}</b><span>Reported positioning: ${esc(c.position)}</span></div><p class="desk-preview">${esc(c.summary)}</p>${s?`<p class="inline-note">${link(s.url,s.firm+' · '+s.author)} · ${date(s.date)}</p>`:''}${c.disagreement?`<div class="callout amber section-space">${esc(c.disagreement)}</div>`:''}<p class="inline-note section-space"><b>Next check:</b> ${esc(c.watch)}</p></div></article>`;}
function renderStock(){const s=D.stocks[S.ticker],c=s.curated,r=s.current,root=$('view-stock');root.innerHTML=`<div class="view-head"><div><div class="stock-title"><span class="stock-ticker">${esc(S.ticker)}</span><span class="tag ${s.eligible&&s.pressure_change!=null?'blue':'amber'}">${s.eligible&&s.pressure_change!=null?'Comparable signal':'Incomplete signal coverage'}</span></div><p class="stock-name">${esc(s.name)} · ${date(r.date)}</p></div><div class="toolbar"><label class="label">Company <select class="control" id="stock-select" aria-label="Select a company">${Object.keys(D.stocks).sort().map(t=>`<option value="${t}">${t} · ${esc(D.stocks[t].name)}</option>`).join('')}</select></label><button class="btn" id="export-stock">History CSV ↓</button></div></div><div class="metrics">${metric('Stock price',num(r.price,2),`${s.currency?esc(s.currency)+' · ':''}${pct(s.return5)} over 5 sessions`)}${metric('Attention & sentiment score',num(r.early_pressure,1)+' <span class="unit">/ 100</span>',`${num(s.pressure_change,1,true)} pts over 5 sessions · experimental`)}${metric('X sentiment · 5-session average',num(r.tone5,3),`${num(s.tone_change5,3,true)} vs five sessions earlier`)}${metric('X mentions',num(r.mentions5,0),`5-session total · attention ${num(r.attention_ratio,2)}× prior 20-session baseline`)}</div><div class="stock-grid"><article class="card"><div class="card-head"><div><h2>Price, sentiment & attention</h2><p>Aligned dates · move across the chart to inspect a session.</p></div>${seg('period',[[21,'1M'],[63,'3M'],[126,'6M'],[252,'1Y'],[9999,'All']],S.period)}</div><div class="narr-legend legend"><span><i class="line" style="background:${color.blue}"></i>${esc(S.ticker)} price</span><span><i class="line" style="background:${color.muted}"></i>QQQ price</span><span>Same starting date = 100</span></div><div class="chart-readout" id="stock-readout"></div><div class="stock-charts" id="stock-series"></div><div class="chart-note">Stock price is in its quotation currency; QQQ is in USD. This comparison is not FX-adjusted or sector-neutral. Tone and mentions use rolling 5-session windows. Missing observations remain gaps.</div></article><aside class="card"><section class="side-section"><h3>What to investigate</h3><div class="callout">${stockInterpretation(s)}</div></section><section class="side-section"><details><summary>What does the attention score measure?</summary><p class="inline-note" style="margin-top:10px">A 0–100 experimental blend of attention acceleration (35%), unusually high attention (30%), improving sentiment (20%) and positive-mention share (15%). Each component is ranked against the stock’s own history. A higher score is not a probability of gains or a measure of actual crowded holdings.</p></details></section><section class="side-section"><h3>Author breadth</h3><div class="score-row"><span>Non-news authors · 7d</span><b>${num(c.curated_authors7,0)}</b></div><div class="score-row"><span>Non-news posts · 7d</span><b>${num(c.curated_mentions7,0)}</b></div><div class="score-row"><span>Largest author's share</span><b>${num(c.top_curated_author_pct,1)}${c.top_curated_author_pct!=null?'%':''}</b></div><div class="progress"><span style="width:${Math.max(0,Math.min(100,c.top_curated_author_pct||0))}%;background:${(c.top_curated_author_pct||0)>40?color.amber:color.blue}"></span></div><p class="inline-note">${date(c.asof)} · ${c.curated_authors7>=3?'At least three observed accounts; affiliations may still overlap.':'Sparse account coverage. A large vendor spike is not independently confirmed here.'}</p><div class="detail-links link-list">${(c.source_links||[]).map((u,i)=>link(u,'X source '+(i+1))).join('')}</div></section><section class="side-section"><h3>Explicit investment views</h3><div class="score-row"><span>X stance / 100</span><b>${num(c.stance_score,1)}</b></div><div class="score-row"><span>Explicit stance authors</span><b>${num(c.stance_authors,0)}</b></div><div class="score-row"><span>Reviewed desk tone</span><b>${esc(D.specialist?.companies?.[S.ticker]?.tone||"Not reviewed")}</b></div><div class="score-row"><span>Reviewed desk houses</span><b>${num(D.specialist?.companies?.[S.ticker]?.desk_houses?.length,0)}</b></div><p class="inline-note">X stance uses conservative text rules. Desk tone is a separate contextual reading of dated commentary; it is not measured fund holdings. Neither scale is Bloomberg X sentiment.</p></section><section class="side-section"><h3>Positioning context</h3><div class="score-row"><span>Short-interest reading</span><b>${num(r.short_interest,2)}</b></div><p class="inline-note">${r.short_interest_date?'Observation '+date(r.short_interest_date)+' · delayed input.':'No eligible delayed observation.'} Kept outside the pressure score. Low short interest does not establish crowded longs.</p>${S.ticker==='META'?'<button class="btn section-space" id="open-muse">Inspect Muse & desk commentary →</button>':''}</section></aside></div>${ScoreReturns.preview(D.score_returns,S.ticker)}${specialistPreview(S.ticker)}<article class="card section-space"><div class="card-head"><div><h2>Earlier automatic email excerpts</h2><p>Legacy rule-based extraction. Use the contextual specialist review above for desk interpretation; these snippets can misattribute ambiguous names.</p></div></div><div class="card-body">${s.email_evidence.length?s.email_evidence.map(e=>`<details class="source-item"><summary><span class="tag ${e.stance>0?'green':'amber'}">${e.stance>0?'Positive stance':'Negative stance'}</span> ${esc(e.source)} · ${date(e.date)}<br>${esc(e.subject)}</summary><p class="excerpt">${esc(e.excerpt)}</p><div class="detail-links">${link(e.url,'Open original email')}</div></details>`).join(''):'<p class="inline-note">No qualifying passage in the retained extraction. This does not imply neutral sentiment or an exhaustive review of the mailbox.</p>'}</div></article>`;
 $('stock-select').value=S.ticker;$('stock-select').onchange=e=>{S.ticker=e.target.value;renderStock();};qa('[data-group="period"]',root).forEach(b=>b.onclick=()=>{S.period=+b.dataset.value;renderStock();});$('export-stock').onclick=()=>download(S.ticker+'-research-history.csv',[D.fields,...s.rows]);if($('open-muse'))$('open-muse').onclick=()=>showView('narrative');renderStockCharts();}
function stockInterpretation(s){if(!s.eligible||s.pressure_change==null)return 'The coverage gates do not support a comparable attention-score change. Inspect the available history and sources before drawing a conclusion.';const a=s.pressure_change,p=s.return5,t=s.tone_change5;return a>0&&p<0?`Attention score rose ${num(a,1)} points while price fell ${num(-p,1)}%. Establish whether this is improving conviction or debate around a problem.`:t<0&&p>0?`Price gained ${num(p,1)}% while tone weakened ${num(t,3)}. Read the underlying debate before interpreting this as exhaustion.`:a>0?`Attention score rose ${num(a,1)} points. Check whether new authors and explicit investment views are appearing before the price move.`:`Attention score fell ${num(-a,1)} points. ${s.current.tone5>0?'Absolute tone remains positive.':'Check tone separately.'} Fading discussion is not evidence of selling.`;}
function renderStockCharts(){const rows=stockRows(S.ticker).slice(-S.period),dates=rows.map(r=>r.date),base=rows.find(r=>ChartMath.finite(r.price)&&ChartMath.finite(D.qqq_price[r.date]));const prices=rows.map(r=>base&&r.date>=base.date&&ChartMath.finite(r.price)?100*r.price/base.price:null),benchmark=rows.map(r=>base&&r.date>=base.date&&ChartMath.finite(D.qqq_price[r.date])?100*D.qqq_price[r.date]/D.qqq_price[base.date]:null);let markers=[];if(S.ticker==='META')markers=[{date:'2026-09-08',tag:'A'},{date:'2026-09-21',tag:'B'}];
 $('stock-series').innerHTML=`<div class="chart">${lineChart(dates,[{values:prices,color:color.blue},{values:benchmark,color:color.muted,width:1.8}],{height:230,title:'Price · rebased to 100',markers,id:'price'})}</div><div class="chart">${lineChart(dates,[{values:rows.map(r=>r.tone5),color:color.teal}],{height:155,title:'X sentiment · 5-session average',zero:true,format:v=>num(v,2),id:'tone'})}</div><div class="chart">${lineChart(dates,[{values:rows.map(r=>r.mentions5),color:color.blue,bar:true}],{height:145,title:'X mentions · rolling 5-session total',domain:[0,Math.max(1,...rows.map(r=>r.mentions5||0))*1.1],format:v=>v>=1000?num(v/1000,1)+'k':num(v,0),id:'mentions'})}</div><div class="chart">${lineChart(dates,[{values:rows.map(r=>r.early_pressure),color:color.ink}],{height:135,title:'Attention & sentiment score · 0–100',domain:[0,100],id:'pressure'})}</div>${markers.length?'<p class="inline-note" style="padding:0 18px 10px">A · Muse launch, 08 Sep. B · 21 Sep session after weekend discussion; concurrent analyst actions and product news also matter.</p>':''}`;
 const readout=i=>{const r=rows[i];$('stock-readout').innerHTML=`<b>${date(r.date)}</b><span>Price <b>${num(r.price,2)}</b></span><span>Tone <b>${num(r.tone5,3)}</b></span><span>Mentions <b>${num(r.mentions5,0)}</b></span><span>Attention score <b>${num(r.early_pressure,1)}</b></span>`;};readout(rows.length-1);qa('[data-hover-chart]',$('stock-series')).forEach(rect=>{rect.onpointermove=e=>{const box=rect.getBoundingClientRect(),frac=Math.max(0,Math.min(1,(e.clientX-box.left)/box.width)),i=Math.round(frac*(rows.length-1)),x=68+i/Math.max(1,rows.length-1)*830;readout(i);qa('.crosshair',$('stock-series')).forEach(l=>{l.setAttribute('x1',x);l.setAttribute('x2',x);l.setAttribute('visibility','visible');});};rect.onpointerleave=()=>{readout(rows.length-1);qa('.crosshair',$('stock-series')).forEach(l=>l.setAttribute('visibility','hidden'));};});}
function renderMarket(){
 const root=$('view-market');root.innerHTML='<div id="market-study"><div id="market-inner"></div></div>';
 if(S.marketSection==='correlations')renderMarketCorrelations();
 else if(D.weekly)WeeklyLevels.mount($('market-inner'),D.weekly);
 else $('market-inner').innerHTML='<div class="empty">Conditional-return study unavailable.</div>';
 const tabs=document.createElement('div');tabs.className='toolbar';tabs.style.marginBottom='20px';tabs.innerHTML=seg('marketSection',[['weekly','Level → following week'],['correlations','Correlation diagnostics']],S.marketSection);root.prepend(tabs);qa('[data-group="marketSection"]',tabs).forEach(b=>b.onclick=()=>{S.marketSection=b.dataset.value;renderMarket();});
}
function marketRows(){const M=D.market;return M.series[S.marketTicker].map(r=>Object.fromEntries(M.series_fields.map((f,i)=>[f,r[i]])));}
function renderMarketCorrelations(){const root=$('market-inner'),M=D.market;if(!M){root.innerHTML='<div class="empty">No retained CNN study is available.</div>';return;}const R=M.results[S.marketTicker],forward=R.forward.find(r=>r.horizon===S.horizon),stat=S.marketMode==='same'?R.contemporaneous.same_day:forward;root.innerHTML=`<div><div class="view-head"><div><h1>Market thermometer or leading signal?</h1><p>${date(M.meta.start)} → ${date(M.meta.end)} · ${num(M.meta.matched_sessions,0)} matched sessions · Gross total returns.</p></div>${seg('marketTicker',[['SPY','SPY'],['QQQ','QQQ'],['QQQ/SPY','QQQ / SPY']],S.marketTicker)}</div><div class="thesis"><div class="thesis-number">${num(R.contemporaneous.same_day.pearson,2)}</div><div><strong>Strong same-day association. Uncertain predictive value.</strong><p>CNN moves with market conditions. Its ${S.horizon}-session forward correlation with ${esc(S.marketTicker)} is ${num(forward.pearson,2)}, with a 95% interval of ${num(forward.ci95[0],2)} to ${num(forward.ci95[1],2)}. This interval includes zero.</p></div></div><div class="market-grid"><article class="card"><div class="card-head"><div><h2>${S.marketMode==='same'?'What moves together':'What follows the reading'}</h2><p>${S.marketMode==='same'?'Change in CNN vs same-day return':'CNN level vs later return · entry at next-session close'}</p></div></div><div class="chart-tabs toolbar">${seg('marketMode',[['same','Same day'],['forward','Forward return']],S.marketMode)}<select class="control" id="market-horizon" aria-label="Forward return horizon">${[1,5,20,60].map(h=>`<option value="${h}">${h} sessions forward</option>`).join('')}</select></div><div class="stat-strip"><div><strong>${num(stat.pearson,3)}</strong><span>Pearson correlation</span></div><div><strong>${num(stat.spearman,3)}</strong><span>Spearman correlation</span></div><div><strong>${num(stat.n,0)}</strong><span>Paired observations</span></div></div><div class="card-body chart" id="market-scatter">${marketScatter()}</div><div class="chart-note">${S.marketMode==='same'?'CNN includes price momentum, breadth and volatility inputs; part of this association is mechanical.':'Future returns overlap. Observation counts are not counts of independent bets. Both sign and magnitude change across years.'}</div></article><article class="card"><div class="card-head"><div><h2>How much evidence survives?</h2><p>Correlation estimates with block-bootstrap 95% intervals.</p></div></div><div class="card-body chart">${correlationForest(R)}</div><div class="card-body"><div class="callout">${S.horizon}-session correlation falls to <b>${num(forward.partial_pearson,3)}</b> after controlling for past 20/60-session returns and volatility.</div><div class="score-row"><span>Non-overlapping correlation</span><b>${num(forward.nonoverlap.pearson,3)}</b></div><div class="score-row"><span>Non-overlapping observations</span><b>${num(forward.nonoverlap.n,0)}</b></div></div><div class="chart-note">Dashed line = no correlation. Intervals use 500 circular block samples, block length max(20, horizon); exploratory, without multiple-testing correction.</div></article></div><article class="card section-space"><div class="card-head"><div><h2>Price cycle & sentiment cycle</h2><p>${esc(S.marketTicker)} total-return index rebased to 100 · CNN remains on its own 0–100 scale.</p></div>${seg('marketPeriod',[[252,'1Y'],[756,'3Y'],[9999,'All']],S.marketPeriod)}</div><div class="card-body" id="market-timeline"></div><div class="chart-note">Current-day CNN (${num(M.meta.current.score,1)} on ${date(M.meta.current.timestamp)}) is context only and excluded from this historical study. Missing CNN on 12 Mar 2026 is retained as a gap.</div></article><div class="split section-space"><article class="card"><div class="card-head"><div><h2>Does the relationship persist?</h2><p>Annual correlations · same day versus 20 sessions forward.</p></div></div><div class="card-body chart">${yearlyChart(R.yearly)}</div></article><article class="card"><div class="card-head"><div><h2>What followed extreme fear?</h2><p>20-session returns · descriptive regime averages.</p></div></div><div class="table-wrap"><table><thead><tr><th>CNN band</th><th class="numeric">Days</th><th class="numeric">Mean return</th><th class="numeric">Excess vs all</th></tr></thead><tbody>${R.regimes20.map((r,i)=>`<tr><td>${['Extreme fear','Fear','Neutral','Greed','Extreme greed'][i]}</td><td class="numeric">${r.n}</td><td class="numeric">${pct(r.mean_pct,2)}</td><td class="numeric">${num(r.excess_vs_all_pp,2,true)} pp</td></tr>`).join('')}</tbody></table></div><div class="card-body section-space"><p class="inline-note">Extreme fear excess return: <b>${num(R.regimes20[0].excess_vs_all_pp,2,true)} pp</b>; 95% interval <b>${num(R.regimes20[0].excess_ci95_pp[0],2)} to ${num(R.regimes20[0].excess_ci95_pp[1],2)} pp</b>. It includes zero. Greed is not automatically a sell signal.</p></div></article></div><div class="callout section-space">${S.marketTicker==='QQQ/SPY'?'QQQ/SPY is the ratio of gross total-return indices, not the P&L of a dollar-neutral portfolio. ':''}Retrospective history, potentially revised. No publication-time CNN vintages, causal attribution or validated trading strategy. Sample starts in 2021 and excludes the 2020 crash.</div><p class="inline-note section-space">${link('https://www.cnn.com/markets/fear-and-greed','CNN methodology')} · <a href="cnn-spy-qqq-study.html">Full retained study ↗</a> · <button class="ticker-link" id="export-market">Export plotted data ↓</button></p></div>`;
 $('market-horizon').value=S.horizon;$('market-horizon').disabled=S.marketMode==='same';$('market-horizon').onchange=e=>{S.horizon=+e.target.value;renderMarket();};['marketTicker','marketMode','marketPeriod'].forEach(g=>qa(`[data-group="${g}"]`,root).forEach(b=>b.onclick=()=>{S[g]=g==='marketPeriod'?+b.dataset.value:b.dataset.value;renderMarket();}));$('export-market').onclick=()=>download('cnn-'+S.marketTicker.replace('/','-')+'.csv',[M.series_fields,...M.series[S.marketTicker]]);renderMarketTimeline();bindTips(root);}
function marketScatter(){const rows=marketRows(),same=S.marketMode==='same',xkey=same?'fg_delta_1':'fg',ykey=same?'past_1':'future_'+S.horizon,pairs=rows.filter(r=>ChartMath.finite(r[xkey])&&ChartMath.finite(r[ykey]));const w=700,h=355,l=62,r=22,t=17,b=57,[xl,xh]=same?ChartMath.extent(pairs.map(p=>p[xkey]),true):[0,100],[yl,yh]=ChartMath.extent(pairs.map(p=>p[ykey]),true),x=ChartMath.scale(xl,xh,l,w-r),y=ChartMath.scale(yl,yh,h-b,t);let body='';for(let i=0;i<5;i++){const vx=xl+(xh-xl)*i/4,vy=yl+(yh-yl)*i/4;body+=`<line x1="${x(vx)}" x2="${x(vx)}" y1="${t}" y2="${h-b}" stroke="var(--rd-grid)"/><line x1="${l}" x2="${w-r}" y1="${y(vy)}" y2="${y(vy)}" stroke="var(--rd-grid)"/><text x="${x(vx)}" y="${h-b+23}" text-anchor="middle">${num(vx,0)}</text><text x="${l-10}" y="${y(vy)+4}" text-anchor="end">${num(vy,0)}%</text>`;}body+=`<line x1="${l}" x2="${w-r}" y1="${y(0)}" y2="${y(0)}" stroke="#adbcd0" stroke-dasharray="4 3"/>`;for(const p of pairs)body+=`<circle cx="${x(p[xkey])}" cy="${y(p[ykey])}" r="2.8" fill="${color.blue}" opacity=".25"><title>${p.date}: CNN ${same?'change ':''}${num(p[xkey],2)}; return ${pct(p[ykey],2)}</title></circle>`;const mx=pairs.reduce((s,p)=>s+p[xkey],0)/pairs.length,my=pairs.reduce((s,p)=>s+p[ykey],0)/pairs.length,den=pairs.reduce((s,p)=>s+(p[xkey]-mx)**2,0),slope=den?pairs.reduce((s,p)=>s+(p[xkey]-mx)*(p[ykey]-my),0)/den:0;body+=`<path d="M${x(xl)},${y(my+slope*(xl-mx))} L${x(xh)},${y(my+slope*(xh-mx))}" stroke="${color.ink}" stroke-width="2" fill="none"/><text x="${w/2}" y="${h-10}" text-anchor="middle" class="axis-title">${same?'Daily change in CNN · points':'CNN level · 0–100'}</text><text transform="translate(15,${(h-b)/2}) rotate(-90)" text-anchor="middle">${same?'Same-day return %':S.horizon+'-session future return %'}</text>`;return svg(w,h,'CNN and '+S.marketTicker+' '+(same?'same-day':'forward')+' returns',body);}
function correlationForest(R){const items=[{label:'Same day',...R.contemporaneous.same_day},...R.forward.map(r=>({label:r.horizon+' sessions later',...r}))],w=650,h=296,l=170,r=30,t=35,b=33,x=ChartMath.scale(-1,1,l,w-r);let body=`<rect x="${l}" y="18" width="${w-l-r}" height="42" fill="var(--rd-blue-wash)" rx="5"/>`;for(const v of [-1,-.5,0,.5,1])body+=`<line x1="${x(v)}" x2="${x(v)}" y1="20" y2="${h-b}" stroke="${v===0?'#9eb2cf':'var(--rd-grid)'}" ${v===0?'stroke-dasharray="4 4"':''}/><text x="${x(v)}" y="${h-10}" text-anchor="middle">${num(v,1)}</text>`;items.forEach((r,i)=>{const yy=t+i*49,c=i===0?color.blue:color.teal;body+=`<text x="${l-15}" y="${yy+5}" text-anchor="end" style="fill:${color.ink}">${r.label}</text><line x1="${x(r.ci95[0])}" x2="${x(r.ci95[1])}" y1="${yy}" y2="${yy}" stroke="${c}" stroke-width="4" stroke-linecap="round"/><circle cx="${x(r.pearson)}" cy="${yy}" r="5" fill="${c}" stroke="var(--rd-surface)" stroke-width="1.5"/><text x="${x(r.pearson)}" y="${yy-11}" text-anchor="middle" style="fill:${c};font-size:12px">${num(r.pearson,2)}</text>`;});return svg(w,h,'Same-day and forward correlation with confidence intervals',body);}
function renderMarketTimeline(){const rows=marketRows().slice(-S.marketPeriod),dates=rows.map(r=>r.date);const miss='2026-03-12';let i=dates.findIndex(d=>d>miss);if(i>0&&dates[0]<miss){dates.splice(i,0,miss);rows.splice(i,0,{date:miss,fg:null,total_return_index:null});}const values=ChartMath.indexed(rows.map(r=>r.total_return_index));$('market-timeline').innerHTML=`<div class="chart">${lineChart(dates,[{values,color:color.blue}],{height:210,title:S.marketTicker+' · total return, rebased = 100'})}</div><div class="chart">${lineChart(dates,[{values:rows.map(r=>r.fg),color:color.ink}],{height:185,title:'CNN Fear & Greed · 0–100',domain:[0,100],bands:[{lo:0,hi:25,color:'var(--rd-red-wash)'},{lo:75,hi:100,color:'var(--rd-green-wash)'}]})}</div><div class="legend"><span><i style="background:#d8a4b3"></i>Extreme fear · ≤25</span><span><i style="background:#8dc5b3"></i>Extreme greed · ≥75</span></div>`;}
function yearlyChart(rows){const w=650,h=290,l=58,r=24,t=22,b=43,y=ChartMath.scale(-.6,1,h-b,t),step=(w-l-r)/rows.length;let body='';for(const v of [-.5,0,.5,1])body+=`<line x1="${l}" x2="${w-r}" y1="${y(v)}" y2="${y(v)}" stroke="${v===0?'#9cafc4':'var(--rd-grid)'}"/><text x="${l-10}" y="${y(v)+4}" text-anchor="end">${num(v,1)}</text>`;rows.forEach((r,i)=>{const xx=l+step*(i+.5);[[r.same_day.pearson,color.blue,-15],[r.forward20.pearson,color.teal,7]].forEach(([v,c,dx])=>{body+=`<rect x="${xx+dx}" y="${y(Math.max(v,0))}" width="18" height="${Math.abs(y(v)-y(0))}" fill="${c}" rx="2"><title>${r.year}: ${num(v,3)}</title></rect>`;});body+=`<text x="${xx}" y="${h-17}" text-anchor="middle">${r.year}</text>`;});return `<div class="legend" style="margin-bottom:12px"><span><i style="background:${color.blue}"></i>Same day</span><span><i style="background:${color.teal}"></i>20 sessions forward</span></div>`+svg(w,h,'Annual correlation stability',body);}
function renderNarrative(){const root=$('view-narrative'),N=D.narrative;if(!N){root.innerHTML='<div class="empty">No reviewed narrative snapshot is available.</div>';return;}const c=N.case.current,p=N.case.previous,move=c.return;root.innerHTML=`<div class="view-head"><div><h1>From product chatter to market narrative</h1><p>META / Muse · retained case from ${date(c.monday)} · a template for investigating the next episode.</p></div><span class="tag amber">Retrospective case · not a live alert</span></div><div class="stage-row"><div class="stage"><div class="stage-no">01 · ATTENTION BEFORE THE OPEN</div><h3>Did the discussion accelerate?</h3><div class="stage-value">${p.posts} → ${c.posts} <span class="meta">posts</span></div><p>Matched Friday-close → Monday 08:30 ET windows. Feed share ${num(p.share_bp/100,2)}% → ${num(c.share_bp/100,2)}%.</p></div><div class="stage"><div class="stage-no">02 · DIFFUSION BEYOND THE COMPANY</div><h3>Did new voices join?</h3><div class="stage-value">${p.other_authors} → ${c.other_authors} <span class="meta">other authors</span></div><p>Largest voice still ${num(c.top_author_pct,1)}% of posts. ${N.case.direct_use_authors.length} authors described direct use; this is not an adoption estimate.</p></div><div class="stage"><div class="stage-no">03 · OBSERVED PRICE RESPONSE</div><h3>What happened afterwards?</h3><div class="stage-value up">${pct(move.return_pct,2)} <span class="meta">META</span></div><p>${num(move.excess_qqq_pp,2,true)} pp vs QQQ. Gap ${pct(move.gap_pct,2)}; open-to-last ${pct(move.open_to_last_pct,2)}. Other news also contributed.</p></div></div><div class="stock-grid"><article class="card"><div class="card-head"><div><h2>Who is carrying the narrative?</h2><p>Product names capture mentions that a cashtag search misses.</p></div><select id="topic-select" class="control" aria-label="Select a product narrative">${Object.entries(N.topics).map(([k,t])=>`<option value="${k}">${t.ticker} · ${esc(t.name)}</option>`).join('')}</select></div><div class="narr-legend legend"><span><i style="background:${color.muted}"></i>Company / partner</span><span><i style="background:#617d9f"></i>News</span><span><i style="background:${color.teal}"></i>Other accounts</span></div><div id="narrative-charts" class="stock-charts"></div><div class="chart-note">Daily UTC buckets. 21 Sep is partial through 08:25 ET. Other accounts are not certified independent; known affiliations are incomplete. Source categories count posts, not underlying independent events.</div></article><aside class="card"><section class="side-section"><h3>The useful change</h3><div class="callout">${c.topic_only_posts} of ${c.posts} weekend Muse posts did not explicitly name META or Facebook. Product aliases reveal discussion a ticker-only tracker would miss.</div></section><section class="side-section"><h3>How broad was the conversation?</h3><div class="chart">${weekendComposition(p,c)}</div><p class="inline-note">Company/partner voices remain dominant, even while other-author breadth expands.</p></section><section class="side-section"><h3>What desks said before the move</h3><p class="inline-note">${N.desk.filter(d=>d.pre_open).length} reviewed notes precede the 21 Sep open. Their language includes improving sentiment, limited long-only sponsorship and event risk.</p><div class="source-item"><b>After the move</b><p class="inline-note">The UBS 21 Sep note at 17:25 UTC described hedge-fund crowding after the stock had already risen. The broader review also finds JPM crowding language on 8 Sep. Compare the investor groups and dates in the new specialist dashboard; the later UBS note cannot support a pre-open prediction.</p></div></section><section class="side-section"><h3>Competing explanations</h3>${N.case.confounds.map(e=>`<p class="inline-note" style="margin-bottom:10px">${esc(e.date)} · ${link(e.url,e.event)}</p>`).join('')}<p class="inline-note">This case was chosen after observing the outcome. Co-occurrence is not causal attribution.</p></section></aside></div><article class="card section-space"><div class="card-head"><div><h2>Specialist-sales evidence</h2><p>Original timestamps and broker context. Separate investment views from reported positioning.</p></div><select id="desk-filter" class="control" aria-label="Filter desk notes"><option value="all">All reviewed notes</option><option value="before">Before 21 Sep open</option><option value="after">After 21 Sep open</option></select></div><div class="table-wrap" id="desk-table"></div><div class="chart-note">${num(N.meta.mail_coverage.unique_scanned,0)} message metadata records scanned since 07 Sep; ${num(N.meta.mail_coverage.selected,0)} candidate bodies; ${N.desk.length} META notes reviewed in context. Archive and attachments were not exhaustively reviewed.</div></article><div class="split section-space"><article class="card"><div class="card-head"><div><h2>Check the reversals too</h2><p>Selected descriptive cases · not an unbiased event backtest.</p></div></div><div class="table-wrap"><table><thead><tr><th>Episode</th><th class="numeric">Other authors</th><th class="numeric">Gap</th><th class="numeric">Open → last</th></tr></thead><tbody>${N.comparisons.map(e=>`<tr><td><b>${e.ticker}</b> · ${shortDate(e.date)}</td><td class="numeric">${e.other_authors}</td><td class="numeric ${cls(e.return.gap_pct)}">${pct(e.return.gap_pct)}</td><td class="numeric ${cls(e.return.open_to_last_pct)}">${pct(e.return.open_to_last_pct)}</td></tr>`).join('')}</tbody></table></div><div class="chart-note">A strong opening gap can reverse. Price follow-through and attention diffusion need separate labels.</div></article><article class="card"><div class="card-head"><div><h2>Trace the weekend evidence</h2><p>${c.posts} original posts · three examples of direct-use language.</p></div></div><div class="card-body">${N.case.direct_use_authors.map(author=>{const e=N.weekend_evidence.find(e=>e.handle.toLowerCase()===author.toLowerCase());return e?`<details class="source-item"><summary><b>@${esc(e.handle)}</b> · ${esc(e.tone_label)}</summary><p class="excerpt">${esc(e.text)}</p><p class="inline-note">${esc(e.tone_note)}</p>${link(e.url,'Read original post')}</details>`:'';}).join('')}<details class="source-item"><summary>All ${N.weekend_evidence.length} posts and source classifications</summary>${N.weekend_evidence.map(e=>`<details class="source-item"><summary>@${esc(e.handle)} · ${esc(e.source_type)} · ${shortDate(e.created_at)}</summary><p class="excerpt">${esc(e.text)}</p><p class="inline-note">${esc(e.tone_label)} · ${esc(e.tone_note)}</p>${link(e.url,'Original X post')}</details>`).join('')}</details></div></article></div>`;
 $('topic-select').value=S.topic;$('topic-select').onchange=e=>{S.topic=e.target.value;renderNarrativeCharts();};$('desk-filter').value=S.deskFilter;$('desk-filter').onchange=e=>{S.deskFilter=e.target.value;renderDesks();};renderNarrativeCharts();renderDesks();}
function weekendComposition(p,c){const w=350,h=187,l=4,r=20,max=Math.max(p.posts,c.posts),x=ChartMath.scale(0,max,0,w-l-r);let body='';[p,c].forEach((v,i)=>{const y=33+i*85;body+=`<text x="${l}" y="${y-12}" style="fill:${color.ink}">${shortDate(v.monday)} · ${v.posts} posts / ${v.other_authors} other authors</text>`;let offset=l;[[v.company_posts+v.partner_posts,color.muted],[v.news_posts,'#617d9f'],[v.other_posts,color.teal]].forEach(([n,col])=>{body+=`<rect x="${offset}" y="${y}" width="${x(n)}" height="23" fill="${col}"/>`;offset+=x(n);});body+=`<text x="${l}" y="${y+43}" style="font-size:12px">Largest voice ${num(v.top_author_pct,1)}%</text>`;});return svg(w,h,'Muse weekend post composition',body);}
function stackedMentions(rows){const w=920,h=200,l=68,r=22,t=32,b=32,x=ChartMath.scale(0,Math.max(1,rows.length-1),l,w-r),max=Math.max(1,...rows.map(r=>r.posts))*1.15,y=ChartMath.scale(0,max,h-b,t),bw=Math.max(2,(w-l-r)/rows.length*.65);let body=`<text x="${l}" y="17" class="axis-title">Original topic posts · source mix</text>`;[0,max/2,max].forEach(v=>body+=`<line x1="${l}" x2="${w-r}" y1="${y(v)}" y2="${y(v)}" stroke="var(--rd-grid)"/><text x="${l-10}" y="${y(v)+4}" text-anchor="end">${num(v,0)}</text>`);rows.forEach((r,i)=>{let offset=0;[[r.company_posts+r.partner_posts,color.muted],[r.news_posts,'#617d9f'],[r.other_posts,color.teal]].forEach(([n,c])=>{body+=`<rect x="${x(i)-bw/2}" y="${y(offset+n)}" width="${bw}" height="${Math.max(0,y(offset)-y(offset+n))}" fill="${c}"><title>${r.date}: ${r.posts} posts; ${r.other_authors} other authors${r.partial?' (partial day)':''}</title></rect>`;offset+=n;});});for(let k=0;k<5;k++){const i=Math.round((rows.length-1)*k/4);body+=`<text x="${x(i)}" y="${h-9}" text-anchor="${k===0?'start':k===4?'end':'middle'}">${shortDate(rows[i].date)}</text>`;}return svg(w,h,'Topic mentions by source type',body);}
function renderNarrativeCharts(){const topic=D.narrative.topics[S.topic],rows=topic.daily.filter(r=>r.date>='2026-09-01'),dates=rows.map(r=>r.date);const first=rows.find(r=>r.price!=null&&r.qqq!=null);$('narrative-charts').innerHTML=`<div class="chart">${lineChart(dates,[{values:rows.map(r=>first&&r.price!=null?r.price/first.price*100:null),color:color.blue},{values:rows.map(r=>first&&r.qqq!=null?r.qqq/first.qqq*100:null),color:color.muted,width:1.7}],{height:220,title:topic.ticker+' price (blue) / QQQ (gray) · start = 100'})}</div><div class="chart">${stackedMentions(rows)}</div><div class="chart">${lineChart(dates,[{values:rows.map(r=>r.other_authors),color:color.teal},{values:rows.map(r=>r.new_other_authors),color:color.blue,dash:true}],{height:180,title:'Other-account authors / day · solid = total, dashed = new',domain:[0,Math.max(1,...rows.map(r=>r.other_authors))*1.1]})}</div>`;}
function renderDesks(){const notes=D.narrative.desk.filter(e=>S.deskFilter==='all'||(S.deskFilter==='before'?e.pre_open:!e.pre_open));$('desk-table').innerHTML=`<table class="evidence-table"><thead><tr><th>When · UTC</th><th>Source</th><th>What the desk reported</th></tr></thead><tbody>${notes.map(e=>`<tr><td style="white-space:nowrap">${date(e.date)}<br><small>${e.date.slice(11,16)} UTC</small><br><span class="tag ${e.pre_open?'blue':'amber'}">${e.pre_open?'Before 21 Sep open':'After the move'}</span></td><td><b>${esc(e.firm)}</b><br><small>${esc(e.sender)}</small></td><td class="note-cell"><span class="tag">${esc(e.role)}</span><p style="margin-top:7px">${esc(e.note)}</p><details><summary class="meta">Source & original subject</summary><small>${esc(e.subject)}<br>${link(e.url,'Open in Outlook')}</small></details></td></tr>`).join('')||'<tr><td colspan="3" class="empty">No reviewed notes in this window.</td></tr>'}</tbody></table>`;}
function renderMethod(){const root=$('view-method'),V=D.validation,rows=V.results.filter(r=>r.feature==='early_pressure'&&r.split.startsWith('2026'));root.innerHTML=`<div class="view-head"><div><h1>Build evidence before calling it leading</h1><p>What this version measures, what the checks show and the next steps that would improve the signal.</p></div><span class="tag amber">Experimental score</span></div><div class="method-grid"><article class="card"><div class="card-head"><h2>Four separate questions</h2></div><div class="method-content"><h3>01 · Is attention accelerating?</h3><p>Bloomberg X mention volume, share of discussion, acceleration and own-history percentiles. Product aliases add context that ticker searches miss.</p><h3>02 · Is the tone changing?</h3><p>X sentiment, explicit author stance and specialist-sales observations stay separate. Product enthusiasm is not automatically a stock recommendation.</p><h3>03 · Is the view spreading?</h3><p>Distinct authors, new authors, company/news share and concentration. The collected account sample is not the whole of X.</p><h3>04 · Are positions actually crowded?</h3><p>Unresolved. Discussion alone does not establish holdings, fund flows or portfolio overlap. This requires a separate positioning dataset.</p></div></article><article class="card"><div class="card-head"><h2>Priority improvements</h2></div><div class="method-content"><ol><li><strong>Record alerts before the outcome.</strong> Save immutable first-seen timestamps, source coverage and price at the alert. Evaluate every alert, including those that fail.</li><li><strong>Track event identity across sources.</strong> Map company → product → event; group repeated headlines and broker forwards before counting new evidence.</li><li><strong>Separate desk observations by meaning.</strong> Product adoption, earnings impact, valuation, reported flows, positioning and the desk's own view need distinct labels.</li><li><strong>Measure incremental information.</strong> Test attention and tone after price momentum, volatility, earnings dates and sector moves; use a later evaluation period untouched during development.</li><li><strong>Validate actual crowding.</strong> Add authorised holdings/flow/borrow data. Measure whether narrative diffusion precedes those outcomes, not only a stock-price rally.</li></ol></div></article></div><article class="card section-space"><div class="card-head"><div><h2>The current score has not established a leading edge</h2><p>2026 chronological checks · weekly rank IC across stocks. Higher is better only for the stated target.</p></div></div><div class="table-wrap"><table><thead><tr><th>Target</th><th class="numeric">Horizon</th><th class="numeric">Rank IC</th><th class="numeric">95% block interval</th><th class="numeric">Partial IC</th><th class="numeric">Weeks</th></tr></thead><tbody>${rows.map(r=>`<tr><td>${esc(r.target)}</td><td class="numeric">${r.horizon} sessions</td><td class="numeric">${num(r.ic,3)}</td><td class="numeric">${r.block_ci?num(r.block_ci[0],3)+' to '+num(r.block_ci[1],3):'—'}</td><td class="numeric">${num(r.partial_ic,3)}</td><td class="numeric">${r.weeks}</td></tr>`).join('')}</tbody></table></div><div class="card-body section-space"><p class="inline-note">These checks use retrospectively retrieved data and the present-day universe. They are not a fully point-in-time or independent out-of-sample trading test. Attention-growth targets also share a denominator with current attention.</p><details class="source-item"><summary>All retained features, horizons and chronological checks</summary><div class="table-wrap"><table><thead><tr><th>Feature</th><th>Period</th><th>Target</th><th>Horizon</th><th>IC</th><th>Partial IC</th><th>95% interval</th></tr></thead><tbody>${V.results.map(r=>`<tr><td>${esc(r.feature)}</td><td>${esc(r.split)}</td><td>${esc(r.target)}</td><td>${r.horizon}</td><td>${num(r.ic,3)}</td><td>${num(r.partial_ic,3)}</td><td>${r.block_ci?num(r.block_ci[0],3)+' to '+num(r.block_ci[1],3):'—'}</td></tr>`).join('')}</tbody></table></div></details></div></article><div class="method-grid section-space"><article class="card"><div class="method-content"><h3>Attention score & ranking rules</h3><p>Fixed weights: 35% attention acceleration percentile, 30% abnormal attention percentile, 20% tone-change percentile and 15% bullish-agreement percentile. Missing required components are not reweighted away.</p><p>Top-five rankings compare exactly five sessions. Both mention windows must be complete and contain at least 25 publications. Absolute tone, change in tone and change in attention score are three distinct rankings.</p><p>Chart series are rounded for portability; rankings and statistics use the retained calculated values. Full-resolution source history remains in the local research outputs.</p></div></article><article class="card"><div class="method-content"><h3>Coverage & provenance</h3><p>Stock/vendor data: ${date(D.meta.price_asof)}. Collected X posts: complete through ${date(D.curated_meta.complete_through)}. META/Muse is a fixed 21 Sep case, not a daily alert service.</p><p>The broader specialist-sales review spans ${D.specialist?.meta.companies_with_context||0} companies, including ${D.specialist?.meta.companies_with_direct_view||0} direct desk views. All 106 names have a coverage status. Relevant passages are reviewed with attribution; the mailbox and attachments are not exhaustively read. The original 11-note META case remains a separate retained snapshot.</p><p>CNN history: ${date(D.market?.meta.start)}–${date(D.market?.meta.end)}. ETF returns come from Bloomberg gross total-return indices; current-day CNN is excluded from the historical test.</p><div class="link-list"><a href="crowding-tracker-previous.html">Previous full report (archive) ↗</a><a href="cnn-spy-qqq-study.html">Full CNN study ↗</a><a href="narrative-diffusion.html">Full narrative review ↗</a><a href="specialist-sales.html">All-company specialist review ↗</a></div></div></article></div>`;}
try{const bytes=Uint8Array.from(atob($('snapshot').textContent.trim()),c=>c.charCodeAt(0));const stream=new Blob([bytes]).stream().pipeThrough(new DecompressionStream('gzip'));D=JSON.parse(await new Response(stream).text());$('loading').hidden=true;qa('[data-view]').forEach((b,i,all)=>{b.onclick=()=>showView(b.dataset.view);b.onkeydown=e=>{if(['ArrowLeft','ArrowRight','Home','End'].includes(e.key)){e.preventDefault();const j=e.key==='Home'?0:e.key==='End'?all.length-1:(i+(e.key==='ArrowRight'?1:-1)+all.length)%all.length;all[j].focus();showView(all[j].dataset.view);}};});const requestedTicker=new URLSearchParams(location.hash.slice(1)).get('ticker');if(requestedTicker&&D.stocks[requestedTicker]){S.ticker=requestedTicker;showView('stock');}else showView('radar');}catch(e){$('loading').innerHTML='<strong>Unable to open this snapshot</strong><p>Open the attached HTML in a current version of Edge, Chrome or Firefox.</p><p class="meta">'+esc(e.message)+'</p>';console.error(e);}
})();
</script></div></div><script>
(()=>{
 const button=document.querySelector('.rd-theme');
 if(button)button.addEventListener('click',()=>{
  const dark=document.documentElement.dataset.theme!=='dark';
  document.documentElement.dataset.theme=dark?'dark':'light';
  button.setAttribute('aria-pressed',String(dark));
  button.setAttribute('aria-label',dark?'Switch to light theme':'Switch to dark theme');
 });
})();
</script></body></html>
