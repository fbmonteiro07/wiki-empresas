bd8d7a8e8db51c002ab34018fae"}},"macro":[{"source":"5eba7d81365d","summary":"Generalists sound more bearish about AI durability than dedicated tech investors. The PB relay describes a shift from de-risking to re-grossing after the FOMC; this is desk/client-book evidence, not all-market flows."},{"source":"0f3163ec59ec","summary":"MS PB puts aggregate cyber exposure low in its longer historical distribution and says much SaaS buying was short covering. Aggregate basket percentiles cannot negate single-name crowding in SNOW or CRWD."},{"source":"5faa1617a434","summary":"After the 21 Sep close, Callahan describes a narrow, size-led rally and many questions about whether it moved too far too fast. This post-close note must not be used to predict that day’s rally."}],"survey":{"source":"14e184d867fe","respondents":null,"label":"Barclays client preference survey · 16 Sep 2026","warning":"Share choosing a preferred long, not ownership. Respondent count, respondent stability and sampling weights are not disclosed. June/September are descriptive comparisons, not a tested leading series.","compute":[{"ticker":"AMD","june":40,"september":25},{"ticker":"ARM","june":8,"september":5},{"ticker":"AVGO","june":5,"september":5},{"ticker":"INTC","june":15,"september":25},{"ticker":"MRVL","june":8,"september":8},{"ticker":"NVDA","june":23,"september":30}],"analog":[{"ticker":"ADI","june":13,"september":15},{"ticker":"TXN","june":25,"september":31},{"ticker":"NXPI","june":3,"september":3},{"ticker":"ON","june":10,"september":3},{"ticker":"MCHP","june":0,"september":5},{"ticker":"IFX","june":25,"september":13}],"groups":[{"ticker":"AI semis","june":5,"september":25},{"ticker":"Analog","june":13,"september":8},{"ticker":"Semicap","june":15,"september":20},{"ticker":"Optical","june":3,"september":20},{"ticker":"Memory","june":50,"september":18},{"ticker":"HDDs","june":15,"september":10}]},"highlights":{"crowding":["SNOW","MRVL","LITE","AMZN","CRWD"],"skepticism":["APP","NFLX","RDDT","ORCL","MU"]}}</script><script>'use strict';
const SpecialistView={
 escape:s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])),
 category(c){if(c.disagreement)return 'Divergent';if(c.position==='Crowded long')return 'Crowded long';if(['Short bias','Light interest','Funding short','Cooling positioning'].includes(c.position))return 'Skeptical / light';return 'Other / unknown';},
 filtered(companies,search,coverage,house){const needle=search.toLowerCase();return Object.values(companies).filter(c=>(!needle||(c.ticker+' '+c.name+' '+c.summary+' '+(c.disagreement||'')).toLowerCase().includes(needle))&&(coverage==='All coverage'||(coverage==='Desk disagreements'?!!c.disagreement:c.coverage===coverage))&&(house==='All houses'||c.houses.includes(house))).sort((a,b)=>a.ticker.localeCompare(b.ticker));},
 surveySVG(rows){const e=this.escape,W=620,H=rows.length*46+57,L=110,R=46,max=60,scale=v=>L+(W-L-R)*v/max;let body='';for(let v=0;v<=60;v+=20)body+=`<line x1="${scale(v)}" x2="${scale(v)}" y1="22" y2="${H-20}" stroke="var(--rd-border)"/><text x="${scale(v)}" y="13" text-anchor="middle" fill="var(--rd-muted)" font-size="12">${v}%</text>`;rows.forEach((r,i)=>{const y=44+i*46;body+=`<g><title>${e(r.ticker)}: June ${r.june}%; September ${r.september}%</title><text x="4" y="${y+4}" fill="var(--rd-ink)" font-size="14">${e(r.ticker)}</text><line x1="${scale(r.june)}" x2="${scale(r.september)}" y1="${y}" y2="${y}" stroke="${r.september>=r.june?'#57d7bd':'#ff94ac'}" stroke-width="4"/><circle cx="${scale(r.june)}" cy="${y}" r="5" fill="var(--rd-surface)" stroke="var(--rd-muted)" stroke-width="2"/><circle cx="${scale(r.september)}" cy="${y}" r="6" fill="var(--rd-blue)"/><text x="${W-2}" y="${y+4}" text-anchor="end" fill="var(--rd-ink)" font-size="13">${r.june} → ${r.september}</text></g>`;});return `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="June versus September preferred-long survey"><title>Barclays survey, June and September 2026; share choosing a preferred long</title>${body}</svg>`;},
 csv(rows){return rows.map(row=>row.map(v=>'"'+String(v??'').replace(/"/g,'""')+'"').join(',')).join('\r\n');}
};
if(typeof module!=='undefined')module.exports=SpecialistView;
if(typeof document!=='undefined')(()=>{
 const D=JSON.parse(document.getElementById('specialist-data').textContent),e=SpecialistView.escape,$=id=>document.getElementById(id);
 let selected=new URLSearchParams(location.hash.slice(1)).get('ticker')||'META',survey='groups';if(!D.companies[selected])selected='META';
 const stamp=d=>d?d.slice(0,10)+' '+d.slice(11,16)+' UTC':'No observation';
 const toneClass=t=>['Positive','Improving','Constructive'].includes(t)?'positive':['Cautious','Cooling'].includes(t)?'cautious':'mixed';
 const sourceLink=id=>{const s=D.sources[id];return s?`<a href="${/^(https:\/\/|outlook:)/i.test(s.url)?e(s.url):'#'}" target="_blank" rel="noopener noreferrer">${e(s.firm)} · ${e(s.author)} ↗</a><span> · ${stamp(s.date)}</span>`:'';};
 const m=D.meta;$('stats').innerHTML=[['106','Companies in scope','All names retain a coverage status'],[m.companies_with_direct_view,'Direct desk views','Contextual opinion / investor feedback'],[m.companies_with_context-m.companies_with_direct_view,'Context only','Research, management or news relay'],[m.coverage_gaps,'Coverage gaps','No defensible desk label assigned']].map(([n,label,note])=>`<div class="stat"><span class="muted">${label}</span><b>${n}</b><small>${note}</small></div>`).join('');
 $('coverage').innerHTML=`<div style="display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap"><b>Coverage is part of the signal</b><span class="muted">${m.selected_sources_reviewed} source emails · ${m.reviewed_observations} company observations · ${m.screened_candidates} candidates screened</span></div><div class="coverage"><span style="width:${m.companies_with_direct_view/106*100}%;background:#57d7bd"></span><span style="width:${(m.companies_with_context-m.companies_with_direct_view)/106*100}%;background:var(--rd-blue)"></span><span style="width:${m.coverage_gaps/106*100}%;background:#5e728e"></span></div><div class="legend"><span><i style="background:#57d7bd"></i>Direct desk commentary</span><span><i style="background:var(--rd-blue)"></i>Context without a desk positioning claim</span><span><i style="background:#5e728e"></i>Unknown is not neutral</span></div>`;
 const priorityText={SNOW:'Great operating momentum; who is the incremental buyer?',MRVL:'Consensus long before an event with an elevated expectations bar.',LITE:'Optical enthusiasm meets aggressive buyside earnings assumptions.',AMZN:'Bullish AWS estimates are already widely held.',CRWD:'Crowded security long; AI competition is a separate risk.',APP:'Little enthusiasm; e-commerce proof is the missing catalyst.',NFLX:'Crowded short with growth, engagement and catalyst doubts.',RDDT:'User growth and licensing dominate the debate.',ORCL:'Post-earnings conviction cooled; long-term investors wait.',MU:'Strong business expectations coexist with cautious tactical positioning.'};
 for(const [id,key] of [['crowding-list','crowding'],['skepticism-list','skepticism']])$(''+id).innerHTML=D.highlights[key].map(t=>{const c=D.companies[t],o=c.observations.find(r=>key==='crowding'?r.position==='Crowded long':['Cautious','Cooling','Mixed'].includes(r.tone))||c.observations[0];const s=D.sources[o.source];return `<button class="watch" data-ticker="${t}"><span class="watch-line"><b>${t}</b><span class="pill">${e(c.position)}</span></span><p>${e(priorityText[t])}</p><small>${e(s.firm)} · ${o.date.slice(0,10)}${c.disagreement?' · desk disagreement':''}</small></button>`;}).join('');
 function drawSurvey(){ $('survey-tabs').innerHTML=[['groups','Sectors'],['compute','Compute'],['analog','Analog']].map(([id,label])=>`<button class="choice ${survey===id?'active':''}" data-survey="${id}" aria-pressed="${survey===id}">${label}</button>`).join('');$('survey').innerHTML=SpecialistView.surveySVG(D.survey[survey])+`<div class="legend"><span>○ June</span><span style="color:var(--rd-blue)">● September</span><span>Right labels show exact values</span></div>`;$('survey-note').innerHTML=`${sourceLink(D.survey.source)}<p style="margin-top:7px">${e(D.survey.warning)} Selected names only; omitted options and rounding mean rows need not sum to 100%.</p>`;}
 drawSurvey();
 let matrix='<div></div>'+['Constructive','Mixed','Cautious'].map(t=>`<div class="matrix-label ${toneClass(t)}">${t}</div>`).join('');for(const row of ['Crowded long','Skeptical / light','Divergent','Other / unknown']){matrix+=`<div class="matrix-label">${e(row)}</div>`;for(const col of ['Constructive','Mixed','Cautious']){const names=Object.values(D.companies).filter(c=>c.coverage==='Direct desk view'&&SpecialistView.category(c)===row&&c.tone===col).sort((a,b)=>a.ticker.localeCompare(b.ticker));matrix+=`<div class="matrix-cell">${names.length?names.map(c=>`<button class="ticker" data-ticker="${c.ticker}" title="${e(c.summary)}">${c.ticker}</button>`).join(''):'<span class="muted">—</span>'}</div>`;}}$('matrix').innerHTML=matrix;
 $('house-filter').innerHTML+=[...new Set(Object.values(D.sources).map(s=>s.firm))].sort().map(h=>`<option>${e(h)}</option>`).join('');
 function drawTable(){const rows=SpecialistView.filtered(D.companies,$('search').value,$('coverage-filter').value,$('house-filter').value);$('table-count').textContent=rows.length+' of 106 companies · Sources = reviewed email count / source houses';$('company-table').innerHTML=rows.map(c=>`<tr class="${c.ticker===selected?'selected':''}" data-ticker="${c.ticker}"><td><button class="ticker" data-ticker="${c.ticker}">${c.ticker}</button><small title="${e(c.name)}">${e(c.name)}</small></td><td class="${toneClass(c.tone)}">${e(c.tone)}<small>${e(c.coverage)}</small></td><td>${e(c.position)}<small>${c.latest_direct?c.latest_direct.slice(0,10):'No direct desk date'}</small></td><td>${c.notes} / ${c.houses.length}</td></tr>`).join('')||'<tr><td colspan="4">No companies match these filters.</td></tr>';}
 function drawCompany(){const c=D.companies[selected];$('company-panel').innerHTML=`<div class="pad"><div class="detail-title"><div><div class="eyebrow">${e(c.coverage)}</div><h2>${c.ticker}</h2><p class="muted">${e(c.name)}</p></div><a class="choice" href="crowding-tracker.html#ticker=${c.ticker}">Price & X charts ↗</a></div><div class="read-grid"><div><small>Desk tone</small><b class="${toneClass(c.tone)}">${e(c.tone)}</b></div><div><small>Positioning reported</small><b>${e(c.position)}</b></div></div><div class="keyline">${e(c.summary)}${c.summary_source?`<div class="source">${sourceLink(c.summary_source)}</div>`:''}</div>${c.disagreement?`<div class="keyline amber"><b>Keep the disagreement visible</b><p>${e(c.disagreement)}</p></div>`:''}<div class="space"><h3>The next question</h3><p style="font-size:14px;color:var(--muted);margin-top:7px">${e(c.watch)}</p></div><p class="source">${c.notes} distinct reviewed emails · ${c.houses.length} source houses · ${c.desk_houses.length} with a direct view<br>Latest direct desk observation: ${stamp(c.latest_direct)}</p>${c.coverage==='Context only'?'<p class="source">An upbeat operating or research passage has not been turned into a desk sentiment or ownership score.</p>':''}</div>${c.observations.length?'<div class="note">Evidence timeline · oldest → newest · receipt timestamps · repeated narratives are not independent votes</div>'+[...c.observations].sort((a,b)=>a.date.localeCompare(b.date)).map(o=>`<section class="evidence"><div class="timeline"><b>${stamp(o.date)}</b><span class="pill">${e(o.kind)}</span><span class="${toneClass(o.tone)}">${e(o.tone)}</span></div><p>${e(o.summary)}</p><div class="source">${sourceLink(o.source)}</div><details style="margin-top:9px"><summary>Source passage & attribution</summary><p>${e(D.sources[o.source].subject)}</p><blockquote>${e(o.excerpt)}</blockquote><p>Assistant-reviewed excerpt in context. ${e(o.kind)}; reported position: ${e(o.position)}.</p></details></section>`).join(''):'<div class="empty">A missing view is not a neutral view. No directional label is inferred from ticker mentions, event invitations or another company’s news.</div>'}`;}
 function select(t,scroll=true){if(!D.companies[t])return;selected=t;history.replaceState(null,'','#ticker='+t);drawTable();drawCompany();if(scroll)$('company-panel').scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth',block:'start'});}
 document.addEventListener('click',ev=>{const a=ev.target.closest('[data-ticker]');if(a)select(a.dataset.ticker);const s=ev.target.closest('[data-survey]');if(s){survey=s.dataset.survey;drawSurvey();}});
 $('search').addEventListener('input',drawTable);$('coverage-filter').addEventListener('change',drawTable);$('house-filter').addEventListener('change',drawTable);$('reset').onclick=()=>{$('search').value='';$('coverage-filter').value='All coverage';$('house-filter').value='All houses';drawTable();};
 $('macro').innerHTML=D.macro.map(r=>`<article class="card pad macro"><div class="eyebrow">${e(D.sources[r.source].firm)}</div><p>${e(r.summary)}</p><div class="source">${sourceLink(r.source)}</div></article>`).join('');
 $('method').innerHTML=['scope','dedup','time_rule','labels','highlight_rule'].map(k=>`<p>${e(m[k])}</p>`).join('')+`<p><b>Entity checks:</b> ${m.false_matches_rejected.map(e).join(' · ')}.</p><p>Reuse-first collection: ${m.reused_deliveries} retained deliveries reused; ${m.new_email_bodies} missing bodies retrieved from the fixed sender/window screen. Company pages, X data and the CNN study retain their existing observations.</p>`;
 $('export').onclick=()=>{const rows=[['Ticker','Company','Coverage','Desk tone','Reported positioning','Latest direct UTC','Reviewed emails','Source houses','Summary','Source house','Source author','Source date UTC','Source link','Disagreement','Next question'],...Object.values(D.companies).sort((a,b)=>a.ticker.localeCompare(b.ticker)).map(c=>{const s=D.sources[c.summary_source]||{};return[c.ticker,c.name,c.coverage,c.tone,c.position,c.latest_direct,c.notes,c.houses.join(' / '),c.summary,s.firm,s.author,s.date,s.url,c.disagreement,c.watch];})];const u=URL.createObjectURL(new Blob(['\ufeff'+SpecialistView.csv(rows)],{type:'text/csv;charset=utf-8;'})),a=document.createElement('a');a.href=u;a.download='specialist-sales-coverage.csv';a.click();setTimeout(()=>URL.revokeObjectURL(u),1000);};
 drawTable();drawCompany();
})();
</script></div></div><script>
(()=>{
 const button=document.querySelector('.rd-theme');
 if(button)button.addEventListener('click',()=>{
  const dark=document.documentElement.dataset.theme!=='dark';
  document.documentElement.dataset.theme=dark?'dark':'light';
  button.setAttribute('aria-pressed',String(dark));
  button.setAttribute('aria-label',dark?'Switch to light theme':'Switch to dark theme');
 });
})();
</script></body></html>
