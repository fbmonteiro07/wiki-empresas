1 0 20.5 13Z"/></svg></button></div></header><main id="research-main" tabindex="-1"><section id="narrative-overlay" class="narrative-overlay">
<style>.narrative-overlay{margin:24px 0 36px;border:2px solid var(--rd-teal);background:var(--rd-surface);padding:24px}.narrative-overlay h2{margin-top:0}.narrative-overlay svg{width:100%;height:auto;display:block}.narrative-overlay svg text{font:12px system-ui;fill:var(--rd-muted)}.narr-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:22px}.narr-legend{display:flex;gap:18px;flex-wrap:wrap;font-size:13px;color:var(--rd-muted)}.narr-note{padding:14px 0;border-bottom:1px solid var(--rd-border);font-size:14px}.narr-note p{margin:6px 0}.narr-note details{padding:8px;margin:6px 0}.narr-tag{font-size:11px;color:var(--rd-amber);margin-left:8px}.narrative-overlay table{width:100%;border-collapse:collapse;font-size:13px}.narrative-overlay td,.narrative-overlay th{padding:9px;border-bottom:1px solid var(--rd-border);text-align:right;white-space:normal}.narrative-overlay td:first-child,.narrative-overlay th:first-child{text-align:left}.narrative-overlay .narr-kpi{padding:14px;background:var(--rd-green-wash)}.narr-kpi b{font-size:26px;display:block}.narr-topic[hidden]{display:none}@media(max-width:850px){.narr-grid{grid-template-columns:1fr}.narrative-overlay{padding:15px}}@media print{.narrative-overlay{border:0;padding:0}.narr-topic{break-inside:avoid}}</style>
<div class="eyebrow">NEW · 21 SEPTEMBER 2026 · SPECIALIST SALES + TOPIC DIFFUSION</div>
<h2>Did the narrative spread before the stock moved?</h2>
<p><b>META / Muse:</b> broader discussion before Monday, but substantial company promotion and a separate analyst catalyst. Friday already provides a counterexample: App Store leadership circulated while the stock fell.</p>
<div class="narr-grid"><div><div class="narr-kpi"><b>5 → 12</b>Other-account voices over comparable closed-market windows</div><table><thead><tr><th>Muse · Fri 16:00 to Mon 08:30 ET</th><th>Sep 11–14</th><th>Sep 18–21</th></tr></thead><tbody><tr><td>Original topic posts</td><td>37</td><td>55</td></tr><tr><td>Topic share of collected feed (bp)</td><td>168.0</td><td>237.6</td></tr><tr><td>All distinct authors</td><td>6</td><td>16</td></tr><tr><td>Other-account posts</td><td>5</td><td>15</td></tr><tr><td>Other-account authors</td><td>5</td><td>12</td></tr><tr><td>New other-account authors vs prior 28 days</td><td>4</td><td>6</td></tr><tr><td>Largest author share (%)</td><td>86.5</td><td>67.3</td></tr><tr><td>Posts without META / Facebook text</td><td>32</td><td>42</td></tr></tbody></table></div>
<div><div class="narr-kpi"><b>+11.34% META</b>Bloomberg Sept 21 mark versus Friday · QQQ +2.77% · excess 8.56 pp</div><p>Opening gap: <b>+2.18%</b>. Open to latest vendor mark: <b>+8.96%</b>. A pre-open study must distinguish the gap from a return attainable after the open.</p><p><b>37 of 55 posts</b> were from Alexandr Wang. Removing identified company, commercial-partner and news accounts leaves <b>15 posts / 12 authors</b>; these remaining accounts are not certified independent.</p><p><b>3 distinct authors</b> supplied favorable firsthand-use anecdotes in the reviewed weekend sample. Product utility, monetization hypotheses and disclosed stock positions are separate labels.</p><p><b>42/55 posts did not say META or Facebook.</b> Product aliases materially improve recall. Muse Spark/model-only mentions are excluded from this consumer-agent topic.</p></div></div>
<h3 style="margin-top:26px">Daily price, mentions and breadth · aligned dates, separate scales</h3>
<p><label>Topic <select aria-label="Narrative topic" onchange="document.querySelectorAll('.narr-topic').forEach(el=>el.hidden=el.id!=='narr-'+this.value)"><option value="META_MUSE">META · Muse consumer agent</option><option value="GOOGL_GEMINI">GOOGL · Gemini models and agents</option><option value="NBIS_GPU">NBIS · Nebius GPU economics</option><option value="ORCL_CLOUD">ORCL · Oracle cloud demand and funding</option><option value="NVDA_RUBIN">NVDA · Rubin product cycle</option></select></label></p>
<div class="narr-topic" id="narr-META_MUSE"><h3>META · Muse consumer agent</h3><div class="narr-legend"><span style="color:var(--rd-teal)">● Stock</span><span style="color:var(--rd-purple)">● QQQ</span><span>Price index: first available session = 100</span></div><svg role="img" aria-label="Price index · first available session = 100" viewBox="0 0 940 235" xmlns="http://www.w3.org/2000/svg"><title>Price index · first available session = 100</title><line x1="64" x2="920" y1="200.0" y2="200.0" stroke="var(--rd-grid)"/><text x="55" y="204.0" text-anchor="end">98</text><line x1="64" x2="920" y1="157.5" y2="157.5" stroke="var(--rd-grid)"/><text x="55" y="161.5" text-anchor="end">106</text><line x1="64" x2="920" y1="115.0" y2="115.0" stroke="var(--rd-grid)"/><text x="55" y="119.0" text-anchor="end">114</text><line x1="64" x2="920" y1="72.5" y2="72.5" stroke="var(--rd-grid)"/><text x="55" y="76.5" text-anchor="end">122</text><line x1="64" x2="920" y1="30.0" y2="30.0" stroke="var(--rd-grid)"/><text x="55" y="34.0" text-anchor="end">130</text><text x="64.0" y="223" text-anchor="middle">09-01</text><text x="235.2" y="223" text-anchor="middle">09-05</text><text x="406.4" y="223" text-anchor="middle">09-09</text><text x="577.6" y="223" text-anchor="middle">09-13</text><text x="748.8" y="223" text-anchor="middle">09-17</text><text x="920.0" y="223" text-anchor="middle">09-21</text><polyline fill="none" stroke="var(--rd-teal)" stroke-width="2.7" points="64.0,188.8 106.8,175.9 149.6,159.8 192.4,154.3 363.6,157.2 406.4,120.9 449.2,129.3 492.0,126.1 620.4,110.2 663.2,106.0 706.0,103.2 748.8,95.1 791.6,110.1 920.0,41.9"/><circle cx="64.0" cy="188.8" r="3" fill="var(--rd-teal)"><title>2026-09-01 · META: 100.00</title></circle><circle cx="106.8" cy="175.9" r="3" fill="var(--rd-teal)"><title>2026-09-02 · META: 102.47</title></circle><circle cx="149.6" cy="159.8" r="3" fill="var(--rd-teal)"><title>2026-09-03 · META: 105.56</title></circle><circle cx="192.4" cy="154.3" r="3" fill="var(--rd