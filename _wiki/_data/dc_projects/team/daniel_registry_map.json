{
 "_doc": [
  "Cross-check of Daniel's build matrix (team/daniel_dc_matrix_2026-11-05.html) against our registry. Hand-reviewed 2026-11-09: 'map' keys are 'state|company column|Daniel project name' -> registry campus names (exact, same state). kind: site | portfolio (company-level contract, no site) | excluded (Daniel's own exclusion).",
  "build_dc_delay.py (team_views) reads this file, re-parses Daniel's data from the HTML and computes matched / Daniel-only / registry-only lists; 'findings' are the hand-written reads, each a claim to verify before any registry edit.",
  "MW are not comparable one-to-one: Daniel's are headline figures in mixed units, often whole programmes or full build-outs; ours are dated phases in IT-eq. A MW gap alone is not a contradiction."
 ],
 "reviewed": "2026-11-09",
 "matrix_asof": "2026-11-05",
 "findings": {
  "contradicts": [
   {
    "t": "Nscale / Ionic Barstow (TX)",
    "d": "Daniel: ~200-240 MW IT live in Q3-26 (~104k GB300) for Microsoft, and Microsoft declined the option on the 700 MW phase 2 (FT, ~Nov-5). Registry: only the 466 MW gross expansion, not started, 2027-11; no energized 2026 phase.",
    "ids": "TX-MONAHANS-",
    "status": "fixed",
    "resolution": "Verified (Nscale release 2026-10-01: site live; FT/Reuters 2026-11-04/05: option declined, ~500 MW per Nscale vs 700 MW in the 2025 plan). Added TX-MONAHANS-NSCALE-BASE, 200 MW IT energized 2026-09; the unleased 377 MW row stays, annotated. Timeline ID MSFT-NSCALE-TX-202510."
   },
   {
    "t": "Project Jupiter (NM)",
    "d": "Daniel: Oracle force-majeure notice Sep-26, air-permit hearing Dec 7, target 2028. Registry: 550 MW dated May-27 (GS's FY27 split) and 1,650 MW May-28.",
    "ids": "NM-SANTATERESA-JUPITER",
    "status": "fixed",
    "resolution": "Verified (TechCrunch/Bloomberg 2026-09-24: 2028 target; gas pipeline slipped to 2027-02-01; fuel-cell air permit pending). First 550 MW moved 2027-05 → 2028-06, remaining 1,650 MW 2028-05 → 2028-12 (Epoch end-2028; Bernstein late CY28). Judgment against GS's 25% in FY27."
   },
   {
    "t": "Stargate Lordstown (OH)",
    "d": "Daniel: no large construction seen Apr-26, the town banned future DCs, Mar-27 at risk. Registry: 300 MW facility under construction, 2027-03.",
    "ids": "OH-LORDSTOWN-STARGATE",
    "status": "not adopted",
    "resolution": "Epoch (updated 2026-08-25) shows active construction with the roof mostly on (2026-07-30) and keeps Mar-2027; the village ban became a 180-day moratorium to ~Jul-2026. Registry kept; note added."
   },
   {
    "t": "Nebius Vineland (NJ)",
    "d": "Daniel: all tranches delivered by Aug-26 (per Nebius). Registry: 250 MW still under construction to 2026-12.",
    "ids": "NJ-VINELAND-NEBIUS",
    "status": "not adopted",
    "resolution": "Nebius said all tranches due TO DATE were delivered and expects the rest on schedule (Q2 call 2026-08-12); Epoch saw ~50 MW IT operating (2026-08-24). Registry kept at 2026-12; note added."
   },
   {
    "t": "Core Scientific Dalton (GA)",
    "d": "Daniel: ~175 MW of a 590 MW CoreWeave contract by early-27, plus ~120 MW AMD-backed Phase 3 through 2028. Registry: 28 MW energized Feb-26 and a 145 MW phase with no date.",
    "ids": "GA-DALTON-COREWEAVEDALTON",
    "status": "fixed",
    "resolution": "Verified (Q4-25 call, 2026-03-02): Phase 2 is 145 MW, full delivery early 2027 → dated 2027-03 (was undated); Phase 3 ~120 MW, initial delivery 2027 → new row GA-DALTON-COREWEAVEDALTON-P3 (tenant uncommitted; AMD per Daniel, unverified)."
   },
   {
    "t": "Stargate Milam (TX)",
    "d": "Daniel: first building by Oct-26, full Q4-28. Registry: 2027-04 (TDLR completion + 6 months, our convention) and 2028-06.",
    "ids": "TX-CAMERON-MILAM",
    "status": "not adopted",
    "resolution": "No source shows a building energized in Oct-26; trackers expect service in 2027 (construction from Oct-25, roofing Mar-26). Daniel's date reads as the TDLR completion date, which our convention shifts +6 months. Registry kept."
   },
   {
    "t": "Meta Aiken (SC)",
    "d": "Daniel: spring 2027, Meta's own date. Registry: building 2 at Epoch's Nov-26 estimate, with the conflict noted.",
    "ids": "SC-TRENTON-METAAIKEN",
    "status": "fixed",
    "resolution": "Meta's own target (operational spring 2027) replaces Epoch's unobserved Nov-26 assumption for building 2: 2026-11 → 2027-04."
   }
  ],
  "new": [
   {
    "t": "Microsoft self-builds the registry lacks",
    "d": "Licking County, OH (869 MW, 17 buildings); Catawba County, NC (~720-810 MW) and Person County, NC (1.5 GW, single tracker); Goodyear + El Mirage, AZ (~456 MW); Cheyenne, WY; Boydton, VA; Kenosha, WI; Kent County, MI; West Des Moines / Woodward, IA; Hoffman Estates, IL; Becker, MN. Most without a MW figure."
   },
   {
    "t": "Miner and developer sites with MW",
    "d": "MARA Matagorda, TX (1 GW grid by Oct-27, 2 GW by Apr-28); Fluidstack Cameron County, TX (up to 1.5 GW); IREN Kiowa, OK (1.6 GW power); TeraWulf Chesapeake, MD (up to 1 GW); MARA Hannibal, OH (600 MW); Bitdeer Ohio (870 MW); Cipher Ulysses, OH (200 MW)."
   },
   {
    "t": "Hyperscaler campuses outside the registry",
    "d": "Meta Stanton Springs, GA (424 MW, 384 of it already live) and CleanSpark Sandersville, GA (175 MW IT); AWS Butts / Douglas / Covington, GA (~890 MW); Google West Memphis, AR (~400 MW); Meta via CleanSpark Sealy + Brazoria, TX (~885 MW); AWS NW Louisiana (3 campuses, n/d)."
   },
   {
    "t": "Tenant reads",
    "d": "xAI's Colossus 1 (Memphis) is 100% leased to Anthropic May-26 to May-29 (CNBC 2026-05-06; energized before 2026, so outside the registry window); Riot Rockdale's 191 MW AI-lab lease sits under Anthropic in both."
   }
  ],
  "consistent": [
   {
    "t": "Large AI campuses agree",
    "d": "Frontier 1.4 GW IT, Kilby 2.67 GW of generation, Camellia 3.2 GW, Hut 8 Beacon Point 704 MW IT, Riot Corsicana 910 MW IT, Riot Rockdale 96 MW Dec-27 + 95 MW Jun-28, Nscale Monarch 1.37 GW IT, Meta Bowling Green 422 MW, TeraWulf Justified 401 MW IT and Muskie 1 GW: same MW and dates in both."
   },
   {
    "t": "Registry-only capacity",
    "d": "Mostly colocation without a named end user (QTS, STACK, Rowan, Prime, PowerHouse, CloudHQ, EdgeCore), plus AI-linked campuses he does not carry: Aligned Project Phoenix, PA (1.7 GW IT-eq dated 2029-30), Joliet Technology Center, IL (0.75 GW), Meridian Arc, IN (Fluidstack, 0.43 GW), Google's Wilbarger County 'Project Rise', TX (0.35 GW dated 2028-30) and the Rum Group site in Georgia (Anthropic, 0.1 GW). IT-eq of phases dated 2026-30. Daniel's matrix is organised by end user, so these sit outside it by design."
   }
  ]
 },
